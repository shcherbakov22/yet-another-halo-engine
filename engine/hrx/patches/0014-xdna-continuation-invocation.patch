XDNA loader: iree_hal_amd_xdna_executable_query_continuation resolves an entry's control-only continuation
(no tile setup; valid while the context keeps its resident state). iree-xdna-run --repeat_invocation uses it.

diff --git a/experimental/xdna/executable.c b/experimental/xdna/executable.c
index 4b1c1ee49..ed9922355 100644
--- a/experimental/xdna/executable.c
+++ b/experimental/xdna/executable.c
@@ -302,13 +302,27 @@ iree_status_t iree_hal_amd_xdna_executable_query_invocation(
     iree_host_size_t storage_count,
     const iree_hal_amd_xdna_executable_storage_t* storage,
     amdf_xdna_kernel_command_t* out_command) {
+  return iree_hal_amd_xdna_executable_query_continuation(
+      image, entry_ordinal, storage_count, storage, /*continuation=*/false,
+      out_command);
+}
+
+iree_status_t iree_hal_amd_xdna_executable_query_continuation(
+    const iree_hal_amd_xdna_image_t* image, uint32_t entry_ordinal,
+    iree_host_size_t storage_count,
+    const iree_hal_amd_xdna_executable_storage_t* storage, bool continuation,
+    amdf_xdna_kernel_command_t* out_command) {
   iree_xdna_elf_entry_record_t entry;
   IREE_RETURN_IF_ERROR(iree_hal_amd_xdna_executable_entry(
       image, entry_ordinal, storage_count, storage, &entry));
   const iree_hal_amd_xdna_image_tables_t* tables =
       iree_hal_amd_xdna_image_tables(image);
-  const iree_xdna_elf_invocation_record_t invocation =
+  iree_xdna_elf_invocation_record_t invocation =
       iree_hal_amd_xdna_image_tables_invocation(tables, entry.first_invocation);
+  if (continuation) {
+    invocation = iree_hal_amd_xdna_image_tables_invocation(
+        tables, entry.first_invocation + invocation.next_invocation);
+  }
   const uint32_t ordinal = iree_hal_amd_xdna_image_tables_allocation_use(
       tables, entry.first_allocation_use + invocation.allocation_use);
   const iree_xdna_elf_allocation_record_t allocation =
diff --git a/experimental/xdna/executable.h b/experimental/xdna/executable.h
index 98c80ca45..405083ef3 100644
--- a/experimental/xdna/executable.h
+++ b/experimental/xdna/executable.h
@@ -86,6 +86,16 @@ iree_status_t iree_hal_amd_xdna_executable_query_invocation(
     const iree_hal_amd_xdna_executable_storage_t* storage,
     amdf_xdna_kernel_command_t* out_command);
 
+// Diagnostic: resolves invocation zero, or with |continuation| the image's
+// named continuation after it. The continuation is valid only while context,
+// backing and resident tile state stay intact (not guaranteed when
+// time-sliced).
+iree_status_t iree_hal_amd_xdna_executable_query_continuation(
+    const iree_hal_amd_xdna_image_t* image, uint32_t entry_ordinal,
+    iree_host_size_t storage_count,
+    const iree_hal_amd_xdna_executable_storage_t* storage, bool continuation,
+    amdf_xdna_kernel_command_t* out_command);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
