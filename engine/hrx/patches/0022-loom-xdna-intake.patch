+// constrain.intake (HRX patch 0022, see plan.h), planned after every other
+// channel. The source reads the binding into a memory-tile ring through its
+// own fill channel; each member drains it on its panel's memory-tile drain
+// channel and lands it through its panel's receiving DMA in its panel ring,
+// with descriptors and locks of its own. The chain locks order the members:
+// the fill releases member 0's ready lock, each member's drain the next one's,
+// the last member's the fill's free lock.
+static iree_status_t loom_aie2p_array_plan_intake_channel(
+    loom_aie2p_array_plan_builder_t* builder, uint32_t channel_index,
+    const loom_aie2p_array_endpoint_t* receiver) {
+  loom_aie2p_array_channel_t* channel = &builder->channels[channel_index];
+  const loom_aie2p_array_channel_t* panel =
+      &builder->channels[channel->intake_panel];
+  const loom_aie2p_array_worker_t* worker =
+      &builder->workers[receiver->owner_index];
+  const uint8_t capacity = (uint8_t)channel->capacity;
+  if (panel->stage_dma_index == UINT32_MAX || !panel->stage_panel_stream) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, worker->coordinate,
+        IREE_SV("an intake's panel must be a streamed shared panel member"));
+  }
+  const loom_aie2p_array_dma_plan_t* panel_drain =
+      &builder->dma_channels[panel->stage_dma_index +
+                             (panel->stage_panel_owner == channel->intake_panel
+                                  ? 1u
+                                  : 0u)];
+  const loom_aie2p_array_dma_plan_t* panel_core = NULL;
+  for (iree_host_size_t i = 0; i < builder->dma_channel_cursor; ++i) {
+    const loom_aie2p_array_dma_plan_t* dma = &builder->dma_channels[i];
+    if (dma->channel_index == channel->intake_panel &&
+        dma->flags == 0 &&
+        dma->direction == LOOM_AIE2P_ARRAY_DMA_DIRECTION_STREAM_TO_MEMORY &&
+        loom_aie2p_array_coordinates_equal(dma->coordinate,
+                                           worker->coordinate)) {
+      panel_core = dma;
+    }
+  }
+  if (panel_core == NULL ||
+      panel->record_count % panel_core->buffer_descriptor_count != 0) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, worker->coordinate,
+        IREE_SV("an intake's panel needs its worker's own receiving DMA ring "
+                "of whole repetitions"));
+  }
+  const loom_xdna_tile_coordinate_t stage = {channel->stage_column, 1};
+  loom_aie2p_array_tile_state_t* stage_state =
+      loom_aie2p_array_tile_state(builder, stage);
+  loom_aie2p_array_tile_resources_t* stage_resources = &stage_state->resources;
+  const uint16_t half_capacity =
+      (uint16_t)(stage_resources->facts->dma.buffer_descriptor_count / 2u);
+  if (channel->source_channel_index == channel_index) {
+    // The shim read (a chained transfer: each parity set its own chain).
+    const uint16_t chain = iree_max(
+        1, builder->binding_plans[channel->binding_plan_index].chain_length);
+    loom_aie2p_array_shim_endpoint_proposal_t shim_proposal = {0};
+    if (!loom_aie2p_array_select_shim_endpoint(
+            builder, channel->stage_column,
+            LOOM_AIE2P_ARRAY_DMA_DIRECTION_MEMORY_TO_STREAM,
+            builder->plan->stream_panels ? (uint16_t)(2u * chain) : chain,
+            &shim_proposal)) {
+      return loom_aie2p_array_reject_channel_resources(
+          builder, channel_index, worker->coordinate,
+          IREE_SV("no shim tile has a free memory-to-stream DMA channel and "
+                  "buffer descriptors for the intake"));
+    }
+    // The ring, its fill channel and descriptors, and the chain locks.
+    uint32_t member_count = 0;
+    for (iree_host_size_t i = 0; i < builder->plan->channel_count; ++i) {
+      member_count +=
+          builder->channels[i].source_channel_index == channel_index &&
+          loom_aie2p_array_channel_is_intake(&builder->channels[i]);
+    }
+    loom_aie2p_array_ring_resource_proposal_t ring = {0};
+    const uint8_t fill_channel = stage_resources->next_stream_to_memory_channel;
+    uint16_t* fill_cursor = &stage_state->memory_tile_bd_cursors[fill_channel & 1u];
+    if (loom_aie2p_array_channel_resources_propose_neighbor(
+            stage_resources, stage, /*load_address_base=*/0, capacity,
+            channel->record_byte_length,
+            &ring) != LOOM_AIE2P_ARRAY_CHANNEL_RESOURCE_FAILURE_NONE ||
+        fill_channel >= stage_resources->facts->dma.channel_count_per_direction ||
+        *fill_cursor + capacity > half_capacity ||
+        (uint32_t)ring.post_next_lock + member_count - 1u >
+            stage_resources->facts->lock_count) {
+      return loom_aie2p_array_reject_channel_resources(
+          builder, channel_index, stage,
+          IREE_SV("the intake's memory tile cannot host its ring, fill "
+                  "channel, descriptors and chain locks"));
+    }
+    const uint32_t shim_dma_index = loom_aie2p_array_commit_shim_endpoint(
+        builder, channel_index, &shim_proposal);
+    const loom_aie2p_array_dma_plan_t* shim_dma =
+        &builder->dma_channels[shim_dma_index];
+    channel->sender_dma_index = shim_dma_index;
+    loom_aie2p_array_binding_plan_t* binding_plan =
+        &builder->binding_plans[channel->binding_plan_index];
+    binding_plan->dma_index = shim_dma_index;
+    binding_plan->completion_route_index = UINT32_MAX;
+    loom_aie2p_array_channel_resources_commit_ring(&ring, stage_resources);
+    stage_resources->next_stream_to_memory_channel = fill_channel + 1u;
+    const uint16_t fill_bd =
+        (uint16_t)((fill_channel & 1u) * half_capacity + *fill_cursor);
+    *fill_cursor += capacity;
+    channel->intake_member_count = member_count;
+    channel->intake_chain_lock = loom_aie2p_array_append_lock_pair(
+        builder, channel_index, LOOM_AIE2P_ARRAY_ENDPOINT_DIRECTION_RECEIVE,
+        &ring);
+    for (uint32_t m = 1; m < member_count; ++m) {
+      builder->locks[builder->lock_cursor++] = (loom_aie2p_array_lock_plan_t){
+          .channel_index = channel_index,
+          .coordinate = stage,
+          .lock_id = stage_resources->next_lock++,
+          .initial_value = 0,
+          .ring_endpoint_direction = LOOM_AIE2P_ARRAY_ENDPOINT_DIRECTION_RECEIVE,
+          .consumer_ready = 1,
+      };
+    }
+    channel->intake_fill_dma = (uint32_t)builder->dma_channel_cursor;
+    builder->dma_channels[builder->dma_channel_cursor++] =
+        (loom_aie2p_array_dma_plan_t){
+            .channel_index = channel_index,
+            .coordinate = stage,
+            .direction = LOOM_AIE2P_ARRAY_DMA_DIRECTION_STREAM_TO_MEMORY,
+            .dma_channel = fill_channel,
+            .flags = LOOM_AIE2P_ARRAY_DMA_FLAG_MEMORY_TILE |
+                     LOOM_AIE2P_ARRAY_DMA_FLAG_INTAKE,
+            .buffer_descriptor_start = fill_bd,
+            .buffer_descriptor_count = capacity,
+            .credit_lock_index = channel->intake_chain_lock,
+            .stage_record_base = (uint32_t)builder->stage_record_cursor,
+        };
+    channel->stage_first_record = (uint32_t)builder->stage_record_cursor;
+    for (uint8_t r = 0; r < capacity; ++r) {
+      builder->stage_record_offsets[builder->stage_record_cursor++] =
+          ring.owner_offsets[r];
+    }
+    if (!loom_aie2p_array_route_ingress(
+            &builder->route_builder, channel_index, channel_index,
+            shim_dma->coordinate, shim_dma->dma_channel, stage,
+            LOOM_XDNA_STREAM_PORT_DMA, fill_channel, /*vertical_first=*/false)) {
+      return loom_aie2p_array_diagnose_route_capacity(builder, channel_index);
+    }
+  }
+  const loom_aie2p_array_channel_t* source =
+      &builder->channels[channel->source_channel_index];
+  if (source->intake_fill_dma == UINT32_MAX) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, worker->coordinate,
+        IREE_SV("an intake multicast's source must be planned first"));
+  }
+  channel->sender_dma_index = source->sender_dma_index;
+  channel->stage_first_record = source->stage_first_record;
+  for (uint32_t i = channel->source_channel_index; i < channel_index; ++i) {
+    channel->intake_member +=
+        builder->channels[i].source_channel_index ==
+            channel->source_channel_index &&
+        loom_aie2p_array_channel_is_intake(&builder->channels[i]);
+  }
+  // The member's drain descriptors, on its panel's drain channel.
+  uint16_t* drain_cursor =
+      &stage_state->memory_tile_bd_cursors[panel_drain->dma_channel & 1u];
+  loom_aie2p_array_tile_resources_t* core_resources =
+      &loom_aie2p_array_tile_state(builder, worker->coordinate)->resources;
+  if (*drain_cursor + capacity > half_capacity ||
+      (uint32_t)core_resources->next_buffer_descriptor + capacity >
+          core_resources->facts->dma.buffer_descriptor_count ||
+      (uint32_t)core_resources->next_lock + 2u >
+          core_resources->facts->lock_count) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, worker->coordinate,
+        IREE_SV("no descriptors or locks left for an intake member"));
+  }
+  const uint16_t drain_bd =
+      (uint16_t)((panel_drain->dma_channel & 1u) * half_capacity +
+                 *drain_cursor);
+  *drain_cursor += capacity;
+  channel->intake_drain_dma = (uint32_t)builder->dma_channel_cursor;
+  builder->dma_channels[builder->dma_channel_cursor++] =
+      (loom_aie2p_array_dma_plan_t){
+          .channel_index = channel_index,
+          .coordinate = stage,
+          .direction = LOOM_AIE2P_ARRAY_DMA_DIRECTION_MEMORY_TO_STREAM,
+          .dma_channel = panel_drain->dma_channel,
+          .flags = LOOM_AIE2P_ARRAY_DMA_FLAG_MEMORY_TILE |
+                   LOOM_AIE2P_ARRAY_DMA_FLAG_INTAKE,
+          .buffer_descriptor_start = drain_bd,
+          .buffer_descriptor_count = capacity,
+          .credit_lock_index = source->intake_chain_lock,
+          .stage_record_base = source->stage_first_record,
+      };
+  // The member's core descriptors and lock pair, on its panel's receiving
+  // channel; the credit starts empty (the worker grants it).
+  const loom_aie2p_array_ring_resource_proposal_t core_pair = {
+      .coordinate = worker->coordinate,
+      .credit_lock = core_resources->next_lock,
+      .ready_lock = (uint8_t)(core_resources->next_lock + 1u),
+      .record_count = 0,
+  };
+  core_resources->next_lock += 2u;
+  const uint32_t core_lock_index = loom_aie2p_array_append_lock_pair(
+      builder, channel_index, LOOM_AIE2P_ARRAY_ENDPOINT_DIRECTION_RECEIVE,
+      &core_pair);
+  channel->intake_core_dma = (uint32_t)builder->dma_channel_cursor;
+  builder->dma_channels[builder->dma_channel_cursor++] =
+      (loom_aie2p_array_dma_plan_t){
+          .channel_index = channel_index,
+          .coordinate = worker->coordinate,
+          .direction = LOOM_AIE2P_ARRAY_DMA_DIRECTION_STREAM_TO_MEMORY,
+          .dma_channel = panel_core->dma_channel,
+          .flags = LOOM_AIE2P_ARRAY_DMA_FLAG_INTAKE,
+          .buffer_descriptor_start = core_resources->next_buffer_descriptor,
+          .buffer_descriptor_count = capacity,
+          .credit_lock_index = core_lock_index,
+      };
+  core_resources->next_buffer_descriptor += capacity;
+  // The ring aliases the panel ring: from its first 2048-aligned byte plus
+  // the offset, records rows x pitch bytes apart.
+  const loom_aie2p_array_channel_slot_t* panel_slot =
+      &builder->channel_slots[panel->first_channel_slot];
+  const uint32_t panel_base = panel_slot->receiver_storage.owner_offset;
+  const uint32_t base =
+      ((panel_base + 2047u) & ~2047u) + channel->intake_offset;
+  const uint32_t record_pitch = channel->intake_rows * channel->intake_pitch;
+  const uint32_t panel_end =
+      panel_base + panel->capacity * panel->record_byte_length;
+  if (base + capacity * record_pitch > panel_end) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, worker->coordinate,
+        IREE_SV("an intake ring must lie within its panel ring"));
+  }
+  for (uint32_t slot = 0; slot < capacity; ++slot) {
+    const uint32_t owner_offset = base + slot * record_pitch;
+    builder->channel_slots[builder->channel_slot_cursor++] =
+        (loom_aie2p_array_channel_slot_t){
+            .channel_index = channel_index,
+            .slot = slot,
+            .byte_length = channel->record_byte_length,
+            .sender_storage = {.owner = {UINT16_MAX, UINT16_MAX},
+                               .owner_offset = UINT32_MAX,
+                               .load_address = UINT32_MAX},
+            .receiver_storage = {.owner = worker->coordinate,
+                                 .owner_offset = owner_offset,
+                                 .load_address =
+                                     core_resources->facts->memory.local_load_base +
+                                     owner_offset},
+        };
+  }
+  loom_aie2p_array_bind_worker_port(builder, receiver, channel_index,
+                                    core_lock_index);
+  return iree_ok_status();
+}
