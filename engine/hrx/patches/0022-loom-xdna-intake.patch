+// Queues one task on a memory-tile or compute DMA channel: |descriptor|'s
+// chain, run |repeat| + 1 times.
+static iree_status_t loom_aie2p_program_queue_task(
+    loom_aie2p_array_program_builder_t* builder,
+    const loom_aie2p_array_dma_plan_t* dma, uint16_t descriptor,
+    uint32_t repeat) {
+  const bool memory_tile =
+      iree_any_bit_set(dma->flags, LOOM_AIE2P_ARRAY_DMA_FLAG_MEMORY_TILE);
+  const bool drain =
+      dma->direction == LOOM_AIE2P_ARRAY_DMA_DIRECTION_MEMORY_TO_STREAM;
+  const uint16_t indices[] = {dma->dma_channel};
+  loom_aie2p_register_update_t task = {0};
+  IREE_RETURN_IF_ERROR(loom_aie2p_program_resolve_field_update(
+      builder->plan,
+      memory_tile
+          ? (drain ? LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_CHANNEL_MM2S_START_QUEUE_START_BD_ID
+                   : LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_CHANNEL_S2MM_START_QUEUE_START_BD_ID)
+          : (drain ? LOOM_XDNA_REGISTER_FIELD_COMPUTE_MEMORY_DMA_CHANNEL_MM2S_START_QUEUE_START_BD_ID
+                   : LOOM_XDNA_REGISTER_FIELD_COMPUTE_MEMORY_DMA_CHANNEL_S2MM_START_QUEUE_START_BD_ID),
+      dma->coordinate, IREE_ARRAYSIZE(indices), indices, descriptor, &task));
+  loom_aie2p_register_update_t count = {0};
+  IREE_RETURN_IF_ERROR(loom_aie2p_program_resolve_field_update(
+      builder->plan,
+      memory_tile
+          ? (drain ? LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_CHANNEL_MM2S_START_QUEUE_REPEAT_COUNT
+                   : LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_CHANNEL_S2MM_START_QUEUE_REPEAT_COUNT)
+          : (drain ? LOOM_XDNA_REGISTER_FIELD_COMPUTE_MEMORY_DMA_CHANNEL_MM2S_START_QUEUE_REPEAT_COUNT
+                   : LOOM_XDNA_REGISTER_FIELD_COMPUTE_MEMORY_DMA_CHANNEL_S2MM_START_QUEUE_REPEAT_COUNT),
+      dma->coordinate, IREE_ARRAYSIZE(indices), indices, repeat, &count));
+  IREE_RETURN_IF_ERROR(loom_aie2p_program_merge_register_update(&count, &task));
+  loom_aie2p_program_append_register_write32(&builder->control, task.address,
+                                             task.value);
+  return iree_ok_status();
+}
