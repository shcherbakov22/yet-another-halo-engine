+// An intake's memory-tile descriptor: the fill takes the free lock and
+// releases member 0's ready lock; member m's drain takes its ready lock and
+// releases the next member's, the last member's the free lock. Both are
+// terminating chains queued per push, so no task outlives a push (a setup
+// that follows starts from idle channels and its own lock values).
+static iree_status_t loom_aie2p_program_build_intake_memory_tile_descriptor(
+    loom_aie2p_array_program_builder_t* builder,
+    const loom_aie2p_array_dma_plan_t* dma, uint32_t slot_ordinal) {
+  const loom_aie2p_array_plan_t* plan = builder->plan;
+  const loom_aie2p_array_channel_t* channel =
+      &plan->channels[dma->channel_index];
+  const loom_aie2p_array_channel_t* source =
+      &plan->channels[channel->source_channel_index];
+  const bool fill =
+      dma->direction == LOOM_AIE2P_ARRAY_DMA_DIRECTION_STREAM_TO_MEMORY;
+  const uint32_t chain = source->intake_chain_lock;
+  const uint32_t m = channel->intake_member;
+  const loom_aie2p_array_lock_plan_t* acquire_lock =
+      &plan->locks[fill ? chain : chain + 1u + m];
+  const loom_aie2p_array_lock_plan_t* release_lock =
+      &plan->locks[fill ? chain + 1u
+                        : (m + 1u < source->intake_member_count ? chain + 2u + m
+                                                                : chain)];
+  uint16_t acquire_selector = 0;
+  uint16_t release_selector = 0;
+  IREE_RETURN_IF_ERROR(loom_xdna_array_form_lock_selector(
+      plan->family, dma->coordinate, acquire_lock->coordinate,
+      acquire_lock->lock_id, &acquire_selector));
+  IREE_RETURN_IF_ERROR(loom_xdna_array_form_lock_selector(
+      plan->family, dma->coordinate, release_lock->coordinate,
+      release_lock->lock_id, &release_selector));
+  const loom_xdna_tile_facts_t* tile =
+      loom_xdna_array_tile_facts(plan->family, dma->coordinate);
+  const uint16_t buffer_descriptor =
+      dma->buffer_descriptor_start + (uint16_t)slot_ordinal;
+  const uint16_t indices[] = {buffer_descriptor};
+  uint32_t* words = loom_aie2p_program_append_register_block_write32(
+      &builder->array,
+      (uint32_t)loom_xdna_register_field_address_admitted(
+          plan->family,
+          LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD0_BUFFER_LENGTH,
+          dma->coordinate, indices),
+      LOOM_AIE2P_MEMORY_TILE_DMA_BUFFER_DESCRIPTOR_WORD_COUNT);
+  memset(words, 0,
+         LOOM_AIE2P_MEMORY_TILE_DMA_BUFFER_DESCRIPTOR_WORD_COUNT *
+             sizeof(*words));
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD0_BUFFER_LENGTH,
+      channel->record_byte_length / tile->dma.transfer_length_granularity -
+          tile->dma.transfer_length_offset,
+      &words[0]);
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD1_BASE_ADDRESS,
+      (tile->memory.local_load_base +
+       plan->stage_record_offsets[dma->stage_record_base + slot_ordinal]) >>
+          tile->dma.address_encoding_shift,
+      &words[1]);
+  const bool last = slot_ordinal + 1u == dma->buffer_descriptor_count;
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD1_NEXT_BD,
+      !last ? dma->buffer_descriptor_start + (uint16_t)(slot_ordinal + 1u) : 0,
+      &words[1]);
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD1_USE_NEXT_BD,
+      !last ? 1 : 0, &words[1]);
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD7_VALID_BD, 1, &words[7]);
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD7_LOCK_RELEASE_VALUE, 1,
+      &words[7]);
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD7_LOCK_RELEASE_ID,
+      release_selector, &words[7]);
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD7_LOCK_ACQUIRE_ENABLE, 1,
+      &words[7]);
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD7_LOCK_ACQUIRE_VALUE, -1,
+      &words[7]);
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD7_LOCK_ACQUIRE_ID,
+      acquire_selector, &words[7]);
+  return iree_ok_status();
+}
