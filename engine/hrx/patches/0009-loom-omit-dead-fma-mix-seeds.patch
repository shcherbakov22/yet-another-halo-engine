+// Returns the descriptor packet name of |op| when it is a descriptor-backed
+// low.op (the mnemonic plus the operand-form suffix).
+static iree_string_view_t loom_amdgpu_kernel_emission_op_mnemonic(
+    const loom_low_descriptor_set_t* descriptor_set, const loom_op_t* op) {
+  if (op == NULL || !loom_low_op_isa(op)) return iree_string_view_empty();
+  loom_low_descriptor_packet_t packet = {0};
+  loom_low_descriptor_packet_initialize(descriptor_set, op, &packet);
+  if (packet.descriptor == NULL) return iree_string_view_empty();
+  return loom_low_descriptor_set_string(descriptor_set,
+                                        packet.descriptor->mnemonic_string_ref);
+}
+
+// Returns the op whose tied input (operand 0) is the sole use of |value|.
+static const loom_op_t* loom_amdgpu_kernel_emission_sole_tied_user(
+    const loom_module_t* module, loom_value_id_t value) {
+  const loom_use_t* use =
+      loom_value_single_use(loom_module_value(module, value));
+  return use != NULL && loom_use_operand_index(*use) == 0
+             ? loom_use_user_op(*use)
+             : NULL;
+}
+
+// Omits the seed of a 16-bit lane pair built by two mixed FMA packets: a
+// constant whose sole use is the tied input of v_{fma,mad}_mixlo_f16, whose sole
+// use is the tied input of v_{fma,mad}_mixhi_f16. The low-half packet preserves
+// the high half and the high-half packet overwrites it, so no bit of the seed
+// is ever observed. The node keeps its schedule slot and register assignment;
+// with no descriptor and the compile-time-only trait every planner counts it as
+// zero instructions and neither emitter writes it.
+static void loom_amdgpu_kernel_emission_elide_dead_seeds(
+    const loom_low_emission_frame_t* frame) {
+  const loom_module_t* module = frame->schedule.module;
+  const loom_low_descriptor_set_t* descriptor_set =
+      frame->schedule.target.descriptor_set;
+  loom_low_schedule_node_t* nodes =
+      (loom_low_schedule_node_t*)frame->schedule.nodes;
+  for (uint32_t i = 0; i < frame->schedule.node_count; ++i) {
+    loom_low_schedule_node_t* node = &nodes[i];
+    if (node->op == NULL || !loom_low_const_isa(node->op)) continue;
+    const loom_op_t* low_half = loom_amdgpu_kernel_emission_sole_tied_user(
+        module, loom_low_const_result(node->op));
+    const iree_string_view_t low_mnemonic =
+        loom_amdgpu_kernel_emission_op_mnemonic(descriptor_set, low_half);
+    if (!iree_string_view_starts_with(low_mnemonic,
+                                      IREE_SV("v_fma_mixlo_f16")) &&
+        !iree_string_view_starts_with(low_mnemonic,
+                                      IREE_SV("v_mad_mixlo_f16"))) {
+      continue;
+    }
+    const loom_value_slice_t low_results = loom_low_op_results(low_half);
+    if (low_results.count != 1) continue;
+    const loom_op_t* high_half = loom_amdgpu_kernel_emission_sole_tied_user(
+        module, low_results.values[0]);
+    const iree_string_view_t high_mnemonic =
+        loom_amdgpu_kernel_emission_op_mnemonic(descriptor_set, high_half);
+    if (!iree_string_view_starts_with(high_mnemonic,
+                                      IREE_SV("v_fma_mixhi_f16")) &&
+        !iree_string_view_starts_with(high_mnemonic,
+                                      IREE_SV("v_mad_mixhi_f16"))) {
+      continue;
+    }
+    node->descriptor = NULL;
+    node->traits |= LOOM_TRAIT_COMPILE_TIME_ONLY;
+  }
+}
