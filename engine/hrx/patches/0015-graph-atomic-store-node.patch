--- a/libhrx/src/libhrx/graph_exec.c
+++ b/libhrx/src/libhrx/graph_exec.c
@@ -327,6 +327,21 @@ static iree_status_t hrx_graph_record_partition(
         }
         break;
       }
+      case HRX_GRAPH_NODE_TYPE_INTERNAL_ATOMIC_STORE: {
+        const hrx_graph_atomic_store_node_attrs_internal_t* attrs =
+            &node->attrs.atomic_store;
+        status = iree_hal_command_buffer_atomic_store(
+            command_buffer,
+            IREE_HAL_EXECUTION_STAGE_DISPATCH |
+                IREE_HAL_EXECUTION_STAGE_TRANSFER |
+                IREE_HAL_EXECUTION_STAGE_ATOMIC,
+            IREE_HAL_EXECUTION_STAGE_ATOMIC, attrs->target_ref, attrs->params);
+        if (iree_status_is_ok(status)) {
+          status = iree_hal_resource_set_insert(exec->resource_set, 1,
+                                                &attrs->target_ref.buffer);
+        }
+        break;
+      }
       default: {
         status = iree_make_status(
             IREE_STATUS_INTERNAL,
@@ -501,12 +516,22 @@ iree_status_t hrx_graph_exec_instantiate_locked(
           command_buffer_mode |=
               IREE_HAL_COMMAND_BUFFER_MODE_RETAIN_PROFILE_METADATA;
         }
+        // Atomic store nodes need the ATOMIC category; other partitions keep
+        // their command buffers as before.
+        iree_hal_command_category_t categories =
+            IREE_HAL_COMMAND_CATEGORY_TRANSFER |
+            IREE_HAL_COMMAND_CATEGORY_DISPATCH;
+        for (uint32_t k = 0; k < partition->count; ++k) {
+          if (schedule.sorted_nodes[partition->start_index + k].node->type ==
+              HRX_GRAPH_NODE_TYPE_INTERNAL_ATOMIC_STORE) {
+            categories |= IREE_HAL_COMMAND_CATEGORY_ATOMIC;
+            break;
+          }
+        }
         IREE_RETURN_AND_END_ZONE_IF_ERROR(
             z0, iree_hal_command_buffer_create(
                     iree_hal_queue_family(exec->device->dispatch_queue),
-                    command_buffer_mode,
-                    IREE_HAL_COMMAND_CATEGORY_TRANSFER |
-                        IREE_HAL_COMMAND_CATEGORY_DISPATCH,
+                    command_buffer_mode, categories,
                     /*binding_capacity=*/0, &command_buffer));
         iree_status_t status = iree_hal_resource_set_insert(exec->resource_set,
                                                             1, &command_buffer);
