+// EXPERIMENT LOOM_EXP_SETUP_TILES="col:row,...": invocation 0's array records keep only those tiles' records (a
+// partial setup that re-programs a few workers, e.g. a decoder column swapped between images sharing the rest).
+static bool loom_aie2p_xdna_setup_keep(const loom_aie2p_xdna_entry_t* entry,
+                                       const loom_aie2p_program_record_t* record) {
+  const char* spec = getenv("LOOM_EXP_SETUP_TILES");
+  if (spec == NULL || spec[0] == 0) return true;
+  const loom_xdna_array_family_t* family = entry->array_plan->family;
+  uint32_t column = 0, row = 0;
+  switch (record->type) {
+    case LOOM_AIE2P_PROGRAM_RECORD_TILE_PROGRAM_LOAD: {
+      const loom_aie2p_xdna_tile_t* tile =
+          &entry->tiles[record->value.tile_program_load.tile_program_index];
+      column = tile->coordinate.column;
+      row = tile->coordinate.row;
+      break;
+    }
+    case LOOM_AIE2P_PROGRAM_RECORD_DMA_TASK_WAIT:
+      return false;
+    default: {
+      const uint32_t address =
+          record->type == LOOM_AIE2P_PROGRAM_RECORD_REGISTER_WRITE32
+              ? record->value.register_write32.address
+          : record->type == LOOM_AIE2P_PROGRAM_RECORD_REGISTER_MASK_WRITE32
+              ? record->value.register_mask_write32.address
+              : record->value.register_block_write32.address;
+      column = address >> family->column_shift;
+      row = (address >> family->row_shift) &
+            ((1u << (family->column_shift - family->row_shift)) - 1u);
+      break;
+    }
+  }
+  for (const char* p = spec; *p;) {
+    char* end = NULL;
+    const unsigned long c = strtoul(p, &end, 10);
+    if (end == p || *end != ':') return false;
+    const unsigned long r = strtoul(end + 1, &end, 10);
+    if (c == column && r == row) return true;
+    p = *end == ',' ? end + 1 : end;
+  }
+  return false;
+}
