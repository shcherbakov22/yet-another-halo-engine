@@ -0,0 +1,45 @@
+// Copyright 2026 The IREE Authors
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+// Pointer-root memory access summaries for authored Low functions.
+//
+// Authored Low assembly carries no source memory facts, so every memory effect
+// conservatively aliases every other. This analysis recovers the one fact that
+// authored kernels rely on most: which storage object an access addresses.
+// Pointer values are traced through copies, tied descriptor results (pointer
+// post-increments and address adds) and branch-forwarded block arguments to a
+// low.resource import or a low.storage reservation. Every memory effect whose
+// named address operand reaches exactly one such root receives a summary with
+// that alias root; distinct roots are disjoint, everything else stays
+// conservative. Callers opt in only for targets whose resources are distinct
+// storage objects.
+
+#ifndef LOOM_CODEGEN_LOW_POINTER_ROOTS_H_
+#define LOOM_CODEGEN_LOW_POINTER_ROOTS_H_
+
+#include "iree/base/api.h"
+#include "loom/codegen/low/descriptors.h"
+#include "loom/codegen/low/memory_access.h"
+#include "loom/ir/ir.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Builds a memory access map for |function_op| in |arena|. Effects whose
+// descriptor operand named |address_field| traces to one root are summarized;
+// others are left unrefined. |out_map| is NULL when nothing was refined.
+iree_status_t loom_low_pointer_roots_build_memory_accesses(
+    const loom_module_t* module, const loom_op_t* function_op,
+    const loom_low_descriptor_set_t* descriptor_set,
+    iree_string_view_t address_field, iree_arena_allocator_t* arena,
+    loom_low_memory_access_map_t** out_map);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // LOOM_CODEGEN_LOW_POINTER_ROOTS_H_
