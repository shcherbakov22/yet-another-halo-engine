+// RUN: with-checks emit aie2p-array-plan @pass_through
+
+// A staged ingress channel streams shim -> memory-tile ring -> worker. The
+// memory-tile ring has the channel capacity, spread across the 64 KiB banks;
+// fill and drain use DMA channels of opposite parity so each chain stays
+// inside its descriptor half.
+aie2p.target<array> @array_target
+
+aie2p.target<core> @core_target
+
+low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @pass_through() asm {
+  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
+  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
+  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
+  %three = constant.u32 3 : reg<aie2p.array.scalar : index>
+  %eight = constant.u32 8 : reg<aie2p.array.scalar : index>
+  %workers = group %one
+  %worker = worker %workers, %zero, @consume
+  %input = binding 0, "read"
+  %source = sender %input, 0 : reg<aie2p.array.sender : tile<8x64xi32>>
+  %origin = constant.u64 0 : reg<aie2p.array.offset : offset>
+  %record = view.sender %source, %origin : reg<aie2p.array.sender : tile<64xi32>>
+  %worker_input = receiver %worker, 0 : reg<aie2p.array.receiver : tile<64xi32>>
+  %channel = channel %record, %worker_input, %three, %eight : reg<aie2p.array.channel : tile<64xi32>>
+  constrain.location %worker, %one, %two
+  constrain.stage %channel, %one
+  return
+}
+
+low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @consume() asm {
+  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
+  %value = lda %input, 0
+  st %value, %input, 0
+  return
+}
+
+// ----
+CHECK: lock channel=0 tile=(1,1) id=0 ring=receive role=credit initial=3
+CHECK: lock channel=0 tile=(1,1) id=1 ring=receive role=ready initial=0
+CHECK: stage channel=0 tile=(1,1) records=3 repeat=1 offsets=0x00000,0x10000,0x20000
+CHECK: dma channel=0 tile=(1,0) side=shim direction=memory-to-stream engine-channel=0 bd-start=0 bd-count=1
+CHECK: dma channel=0 tile=(1,1) side=memory direction=stream-to-memory engine-channel=0 bd-start=0 bd-count=3
+CHECK: dma channel=0 tile=(1,1) side=memory direction=memory-to-stream engine-channel=1 bd-start=24 bd-count=3
+CHECK: route channel=0 tile=(1,1) kind=switch source=south[*] destination=dma[0]
+CHECK: route channel=0 tile=(1,1) kind=switch source=dma[1] destination=north[*]
+CHECK: route channel=0 tile=(1,2) kind=switch source=south[*] destination=dma[0]
+CHECK: binding-patch ordinal=0 channel=0 shim=(1,0) * repeat=1*
+
+// ====
+
+// RUN: with-checks emit aie2p-array-plan @replay
+
+// A leading zero-stride binding axis is read once by the shim and replayed by
+// the memory tile: the ring holds one repetition and the shim repeat drops to 1.
+aie2p.target<array> @array_target
+
+aie2p.target<core> @core_target
+
+low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @replay() asm {
+  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
+  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
+  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
+  %records = constant.u32 20 : reg<aie2p.array.scalar : index>
+  %workers = group %one
+  %worker = worker %workers, %zero, @consume
+  %input = binding 0, "read"
+  %source = sender %input, 0 : reg<aie2p.array.sender : tile<4x5x64xi32, #encoding.layout.strided<strides=[0, 64, 1]>>>
+  %origin = constant.u64 0 : reg<aie2p.array.offset : offset>
+  %record = view.sender %source, %origin : reg<aie2p.array.sender : tile<64xi32>>
+  %worker_input = receiver %worker, 0 : reg<aie2p.array.receiver : tile<64xi32>>
+  %channel = channel %record, %worker_input, %two, %records : reg<aie2p.array.channel : tile<64xi32>>
+  constrain.location %worker, %zero, %two
+  constrain.stage %channel, %zero
+  return
+}
