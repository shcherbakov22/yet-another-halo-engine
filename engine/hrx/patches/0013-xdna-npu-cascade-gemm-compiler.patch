+// ----
+CHECK: stage channel=0 tile=(0,1) records=5 repeat=4 offsets=0x00000,0x10000,0x20000,0x30000,0x40000
+CHECK: dma channel=0 tile=(0,1) side=memory direction=stream-to-memory engine-channel=0 bd-start=0 bd-count=5
+CHECK: dma channel=0 tile=(0,1) side=memory direction=memory-to-stream engine-channel=1 bd-start=24 bd-count=5
+CHECK: binding-patch ordinal=0 channel=0 shim=(0,0) * transfer=1280 repeat=1*
+
+// ====
+
+// RUN: with-checks emit aie2p-array-plan @multicast
+
+// Channels sharing a staged binding sender branch from the memory-tile drain;
+// only the first owns the shim leg and the memory-tile ring.
+aie2p.target<array> @array_target
+
+aie2p.target<core> @core_target
+
+low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @multicast() asm {
+  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
+  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
+  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
+  %three = constant.u32 3 : reg<aie2p.array.scalar : index>
+  %eight = constant.u32 8 : reg<aie2p.array.scalar : index>
+  %workers = group %two
+  %near = worker %workers, %zero, @consume
+  %far = worker %workers, %one, @consume
+  %input = binding 0, "read"
+  %source = sender %input, 0 : reg<aie2p.array.sender : tile<8x64xi32>>
+  %origin = constant.u64 0 : reg<aie2p.array.offset : offset>
+  %record = view.sender %source, %origin : reg<aie2p.array.sender : tile<64xi32>>
+  %near_input = receiver %near, 0 : reg<aie2p.array.receiver : tile<64xi32>>
+  %far_input = receiver %far, 0 : reg<aie2p.array.receiver : tile<64xi32>>
+  %near_channel = channel %record, %near_input, %two, %eight : reg<aie2p.array.channel : tile<64xi32>>
+  %far_channel = channel %record, %far_input, %two, %eight : reg<aie2p.array.channel : tile<64xi32>>
+  constrain.location %near, %zero, %two
+  constrain.location %far, %zero, %three
+  constrain.stage %near_channel, %zero
+  return
+}
+
+low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @consume() asm {
+  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
+  %value = lda %input, 0
+  st %value, %input, 0
+  return
+}
+
+// ----
+CHECK: stage channel=0 tile=(0,1) records=2 repeat=1 *
+CHECK: dma channel=0 tile=(0,1) side=memory direction=memory-to-stream *
+CHECK: dma channel=1 tile=(0,3) side=compute direction=stream-to-memory *
+CHECK: route channel=1 tile=(0,3) kind=switch source=south[*] destination=dma[0]
+CHECK-NOT: stage channel=1 *
+CHECK-NOT: dma channel=1 * side=shim *
+CHECK-NOT: dma channel=1 * side=memory *
+CHECK-NOT: binding-patch * channel=1 *
