+// A leaf drives its leaf-synchronized ports with `acq`/`rel` whose id is the
+// port index; the wrapper rewrites each to the port's lock (receive: acquire
+// ready, release credit; send: acquire credit, release ready).
+static iree_status_t loom_aie2p_array_resident_rewrite_leaf_locks(
+    loom_aie2p_array_resident_builder_t* builder, loom_builder_t* ir_builder,
+    uint32_t worker_index, loom_region_t* resident_body,
+    uint16_t source_block_start, uint16_t source_block_count) {
+  const loom_aie2p_array_worker_plan_t* worker_plan =
+      &builder->plan->worker_plans[worker_index];
+  for (uint16_t block_ordinal = 0; block_ordinal < source_block_count;
+       ++block_ordinal) {
+    loom_block_t* block = loom_region_block(
+        resident_body, (uint16_t)(source_block_start + block_ordinal));
+    loom_op_t* op = block->first_op;
+    while (op != NULL) {
+      loom_op_t* next_op = op->next_op;
+      loom_low_descriptor_packet_t packet = {0};
+      loom_low_descriptor_packet_initialize(builder->descriptor_set, op,
+                                            &packet);
+      const bool is_op = packet.kind != LOOM_LOW_DESCRIPTOR_PACKET_NONE;
+      const uint32_t ordinal = packet.descriptor_ordinal;
+      const bool acquire =
+          is_op &&
+          (ordinal == AIE2P_CORE_DESCRIPTOR_REF_LOCK_ACQUIRE_IMMEDIATE ||
+           ordinal ==
+               AIE2P_CORE_DESCRIPTOR_REF_LOCK_ACQUIRE_CONDITIONAL_IMMEDIATE);
+      const bool release =
+          is_op &&
+          (ordinal == AIE2P_CORE_DESCRIPTOR_REF_LOCK_RELEASE_IMMEDIATE ||
+           ordinal ==
+               AIE2P_CORE_DESCRIPTOR_REF_LOCK_RELEASE_CONDITIONAL_IMMEDIATE);
+      if (acquire || release) {
+        int64_t id = -1;
+        const loom_named_attr_slice_t attrs = loom_low_op_attrs(op);
+        for (iree_host_size_t i = 0; i < attrs.count; ++i) {
+          if (attrs.entries[i].name_id == builder->lock_selector_name) {
+            id = loom_attr_as_i64(attrs.entries[i].value);
+          }
+        }
+        for (uint32_t i = 0; i < worker_plan->port_count; ++i) {
+          const loom_aie2p_array_worker_port_plan_t* port =
+              &builder->plan->worker_ports[worker_plan->first_port + i];
+          if (!builder->plan->channels[port->channel_index].leaf_sync ||
+              (int64_t)port->port != id) {
+            continue;
+          }
+          const bool receive =
+              port->direction == LOOM_AIE2P_ARRAY_ENDPOINT_DIRECTION_RECEIVE;
+          const loom_aie2p_array_lock_role_t role =
+              receive == acquire ? LOOM_AIE2P_ARRAY_LOCK_ROLE_READY
+                                 : LOOM_AIE2P_ARRAY_LOCK_ROLE_CREDIT;
+          const loom_aie2p_array_lock_plan_t* lock =
+              &builder->plan->locks[port->credit_lock_index + role];
+          uint16_t selector = 0;
+          IREE_RETURN_IF_ERROR(loom_xdna_array_form_lock_selector(
+              builder->plan->family, worker_plan->coordinate, lock->coordinate,
+              lock->lock_id, &selector));
+          const loom_named_attr_t attribute = {
+              .name_id = builder->lock_selector_name,
+              .value = loom_attr_i64(selector),
+          };
+          loom_builder_set_before(ir_builder, op);
+          IREE_RETURN_IF_ERROR(loom_aie2p_array_resident_build_op(
+              builder, ir_builder, ordinal, loom_op_operands(op),
+              op->operand_count, loom_make_named_attr_slice(&attribute, 1),
+              /*result_type=*/NULL, op->location, /*out_value=*/NULL));
+          IREE_RETURN_IF_ERROR(loom_op_erase(builder->module, op));
+          break;
+        }
+      }
+      op = next_op;
+    }
+  }
+  return iree_ok_status();
+}
