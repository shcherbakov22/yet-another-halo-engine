diff --git a/loom/src/loom/target/arch/amd/xdna/aie2p/test/descriptors/cascade_timing.loom-test b/loom/src/loom/target/arch/amd/xdna/aie2p/test/descriptors/cascade_timing.loom-test
new file mode 100644
index 000000000..0e649af31
--- /dev/null
+++ b/loom/src/loom/target/arch/amd/xdna/aie2p/test/descriptors/cascade_timing.loom-test
@@ -0,0 +1,24 @@
+// RUN: with-checks emit aie2p-leaf @relay report=emission
+
+// Cascade transfers stay in order on each link but never wait for a read's
+// result latency: input and output links are independent streams, and local
+// memory traffic only keeps its issue order around them.
+aie2p.target<core> @target
+
+low.func.def schedule(locked) target<amd.xdna.aie2p.core>(@target) @relay(%output: reg<aie2p.ep>) asm {
+  set.scd-enable 1
+  set.mcd-enable 1
+  %first = vmov.scd.acc
+  %second = vmov.scd.acc
+  %third = vmov.scd.acc
+  %fourth = vmov.scd.acc
+  vmov.mcd.acc %first
+  vst.acc %second, %output, 0
+  vmov.mcd.acc %second
+  vmov.mcd.acc %third
+  vmov.mcd.acc %fourth
+  return
+}
+
+// ----
+CHECK: issue cycles: 14
