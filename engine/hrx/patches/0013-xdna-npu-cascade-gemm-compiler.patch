+// Byte span of group |group| in a streamed owner's panel transfer: the panel
+// is laid out group-major ([group][member][records of the group]).
+static void loom_aie2p_program_stream_group_span(
+    const loom_aie2p_array_plan_t* plan, uint32_t owner_index, uint32_t group,
+    uint32_t* out_offset, uint32_t* out_length) {
+  uint32_t offset = 0;
+  uint32_t length = 0;
+  for (uint32_t g = 0; g <= group; ++g) {
+    uint32_t span = 0;
+    for (iree_host_size_t i = 0; i < plan->channel_count; ++i) {
+      const loom_aie2p_array_channel_t* member = &plan->channels[i];
+      if (member->stage_panel_owner != owner_index) continue;
+      span += (uint32_t)(member->stage_panel_group_records[g] *
+                         member->record_byte_length);
+    }
+    if (g < group) offset += span;
+    length = span;
+  }
+  *out_offset = offset;
+  *out_length = length;
+}
