diff --git a/loom/src/loom/codegen/low/pointer_roots.c b/loom/src/loom/codegen/low/pointer_roots.c
new file mode 100644
index 000000000..d4353d287
--- /dev/null
+++ b/loom/src/loom/codegen/low/pointer_roots.c
@@ -0,0 +1,243 @@
+// Copyright 2026 The IREE Authors
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "loom/codegen/low/pointer_roots.h"
+
+#include "loom/codegen/low/representation_binding.h"
+#include "loom/ops/low/ops.h"
+
+// Lattice: UNDEF (not yet derived), a root id, or UNKNOWN (conflicting or
+// untraceable). Root ids are small dense integers below UNKNOWN.
+#define LOOM_POINTER_ROOT_UNDEF 0u
+#define LOOM_POINTER_ROOT_UNKNOWN UINT32_MAX
+// Resource imports use their resource index; reservations follow them.
+#define LOOM_POINTER_ROOT_STORAGE_BASE 0x10000u
+
+typedef struct loom_pointer_roots_t {
+  const loom_module_t* module;
+  const loom_low_descriptor_set_t* descriptor_set;
+  uint32_t* roots;
+  iree_host_size_t value_count;
+  uint32_t next_storage_root;
+  bool changed;
+} loom_pointer_roots_t;
+
+static uint32_t loom_pointer_roots_get(const loom_pointer_roots_t* state,
+                                       loom_value_id_t value_id) {
+  return value_id < state->value_count ? state->roots[value_id]
+                                       : LOOM_POINTER_ROOT_UNKNOWN;
+}
+
+static void loom_pointer_roots_set(loom_pointer_roots_t* state,
+                                   loom_value_id_t value_id, uint32_t root) {
+  if (value_id >= state->value_count || root == LOOM_POINTER_ROOT_UNDEF) {
+    return;
+  }
+  uint32_t* slot = &state->roots[value_id];
+  uint32_t merged = root;
+  if (*slot != LOOM_POINTER_ROOT_UNDEF && *slot != root) {
+    merged = LOOM_POINTER_ROOT_UNKNOWN;
+  }
+  if (merged != *slot) {
+    *slot = merged;
+    state->changed = true;
+  }
+}
+
+// Marks every value defined in |function_op| UNKNOWN except block arguments
+// and results of root-carrying ops, which start UNDEF.
+static void loom_pointer_roots_seed(loom_pointer_roots_t* state,
+                                    const loom_region_t* body) {
+  for (iree_host_size_t i = 0; i < state->value_count; ++i) {
+    state->roots[i] = LOOM_POINTER_ROOT_UNKNOWN;
+  }
+  loom_block_t* block = NULL;
+  loom_region_for_each_block(body, block) {
+    for (uint16_t i = 0; i < block->arg_count; ++i) {
+      if (block->arg_ids[i] < state->value_count) {
+        state->roots[block->arg_ids[i]] = LOOM_POINTER_ROOT_UNDEF;
+      }
+    }
+    loom_op_t* op = NULL;
+    loom_block_for_each_op(block, op) {
+      const loom_value_id_t* results = loom_op_const_results(op);
+      for (uint16_t r = 0; r < op->result_count; ++r) {
+        if (results[r] < state->value_count) {
+          state->roots[results[r]] = LOOM_POINTER_ROOT_UNDEF;
+        }
+      }
+    }
+  }
+}
+
+static void loom_pointer_roots_visit_op(loom_pointer_roots_t* state,
+                                        const loom_op_t* op) {
+  const loom_value_id_t* operands = loom_op_const_operands(op);
+  const loom_value_id_t* results = loom_op_const_results(op);
+  if (loom_low_resource_isa(op)) {
+    const int64_t index = loom_low_resource_index(op);
+    loom_pointer_roots_set(state, results[0],
+                           index >= 0 && index < LOOM_POINTER_ROOT_STORAGE_BASE
+                               ? (uint32_t)index + 1u
+                               : LOOM_POINTER_ROOT_UNKNOWN);
+    return;
+  }
+  if (loom_low_storage_reserve_isa(op)) {
+    if (state->roots[results[0]] == LOOM_POINTER_ROOT_UNDEF) {
+      loom_pointer_roots_set(state, results[0], state->next_storage_root++);
+    }
+    return;
+  }
+  if (loom_low_storage_view_isa(op) || loom_low_storage_address_isa(op) ||
+      loom_low_copy_isa(op)) {
+    loom_pointer_roots_set(state, results[0],
+                           loom_pointer_roots_get(state, operands[0]));
+    return;
+  }
+  if (loom_low_br_isa(op)) {
+    const loom_block_t* dest = loom_op_const_successors(op)[0];
+    for (uint16_t i = 0; i < op->operand_count && i < dest->arg_count; ++i) {
+      loom_pointer_roots_set(state, dest->arg_ids[i],
+                             loom_pointer_roots_get(state, operands[i]));
+    }
+    return;
+  }
+  loom_low_descriptor_packet_t packet;
+  loom_low_descriptor_packet_initialize(state->descriptor_set, op, &packet);
+  if (packet.kind != LOOM_LOW_DESCRIPTOR_PACKET_OP) {
+    // Remaining results are untraceable.
+    for (uint16_t r = 0; r < op->result_count; ++r) {
+      loom_pointer_roots_set(state, results[r], LOOM_POINTER_ROOT_UNKNOWN);
+    }
+    return;
+  }
+  const loom_low_descriptor_t* descriptor = packet.descriptor;
+  bool* derived = NULL;
+  bool derived_storage[16] = {0};
+  if (op->result_count <= IREE_ARRAYSIZE(derived_storage)) {
+    derived = derived_storage;
+  }
+  for (uint16_t c = 0; c < descriptor->constraint_count; ++c) {
+    const loom_low_constraint_t* constraint =
+        &state->descriptor_set
+             ->constraints[descriptor->constraint_start + c];
+    if (constraint->kind != LOOM_LOW_CONSTRAINT_KIND_TIED ||
+        constraint->rhs_operand_index == LOOM_LOW_ID_NONE) {
+      continue;
+    }
+    const loom_low_operand_t* lhs =
+        &state->descriptor_set
+             ->operands[descriptor->operand_start + constraint->lhs_operand_index];
+    const loom_low_operand_t* rhs =
+        &state->descriptor_set
+             ->operands[descriptor->operand_start + constraint->rhs_operand_index];
+    if (lhs->role != LOOM_LOW_OPERAND_ROLE_RESULT ||
+        rhs->role != LOOM_LOW_OPERAND_ROLE_OPERAND ||
+        lhs->source_value_index >= op->result_count ||
+        rhs->source_value_index >= op->operand_count) {
+      continue;
+    }
+    loom_pointer_roots_set(state, results[lhs->source_value_index],
+                           loom_pointer_roots_get(
+                               state, operands[rhs->source_value_index]));
+    if (derived) derived[lhs->source_value_index] = true;
+  }
+  for (uint16_t r = 0; r < op->result_count; ++r) {
+    if (!derived || !derived[r]) {
+      loom_pointer_roots_set(state, results[r], LOOM_POINTER_ROOT_UNKNOWN);
+    }
+  }
+}
+
+static iree_status_t loom_pointer_roots_summarize_op(
+    loom_pointer_roots_t* state, const loom_op_t* op,
+    iree_string_view_t address_field, iree_arena_allocator_t* arena,
+    loom_low_memory_access_map_t** map) {
+  loom_low_descriptor_packet_t packet;
+  loom_low_descriptor_packet_initialize(state->descriptor_set, op, &packet);
+  if (packet.kind != LOOM_LOW_DESCRIPTOR_PACKET_OP ||
+      packet.descriptor->effect_count == 0) {
+    return iree_ok_status();
+  }
+  const loom_low_descriptor_t* descriptor = packet.descriptor;
+  uint32_t root = LOOM_POINTER_ROOT_UNDEF;
+  for (uint16_t i = 0; i < descriptor->operand_count; ++i) {
+    const loom_low_operand_t* operand =
+        &state->descriptor_set->operands[descriptor->operand_start + i];
+    if (operand->role != LOOM_LOW_OPERAND_ROLE_OPERAND ||
+        operand->source_value_index >= op->operand_count ||
+        !iree_string_view_equal(
+            loom_low_descriptor_set_string(state->descriptor_set,
+                                           operand->field_name_string_ref),
+            address_field)) {
+      continue;
+    }
+    const uint32_t operand_root = loom_pointer_roots_get(
+        state, loom_op_const_operands(op)[operand->source_value_index]);
+    root = root == LOOM_POINTER_ROOT_UNDEF || root == operand_root
+               ? operand_root
+               : LOOM_POINTER_ROOT_UNKNOWN;
+  }
+  if (root == LOOM_POINTER_ROOT_UNDEF || root == LOOM_POINTER_ROOT_UNKNOWN) {
+    return iree_ok_status();
+  }
+  for (uint16_t i = 0; i < descriptor->effect_count; ++i) {
+    const loom_low_effect_t* effect =
+        &state->descriptor_set->effects[descriptor->effect_start + i];
+    if (effect->kind != LOOM_LOW_EFFECT_KIND_READ &&
+        effect->kind != LOOM_LOW_EFFECT_KIND_WRITE) {
+      continue;
+    }
+    if (*map == NULL) {
+      IREE_RETURN_IF_ERROR(loom_low_memory_access_map_create(arena, map));
+    }
+    loom_low_memory_access_summary_t summary =
+        *loom_low_memory_access_summary_for_space(effect->memory_space);
+    summary.alias_root_id = root;
+    summary.precision_flags |= LOOM_LOW_MEMORY_ACCESS_PRECISION_ROOT;
+    IREE_RETURN_IF_ERROR(
+        loom_low_memory_access_map_insert(*map, op, i, &summary));
+  }
+  return iree_ok_status();
+}
+
+iree_status_t loom_low_pointer_roots_build_memory_accesses(
+    const loom_module_t* module, const loom_op_t* function_op,
+    const loom_low_descriptor_set_t* descriptor_set,
+    iree_string_view_t address_field, iree_arena_allocator_t* arena,
+    loom_low_memory_access_map_t** out_map) {
+  *out_map = NULL;
+  const loom_region_t* body = loom_low_func_def_body(function_op);
+  loom_pointer_roots_t state = {
+      .module = module,
+      .descriptor_set = descriptor_set,
+      .value_count = module->values.count,
+      .next_storage_root = LOOM_POINTER_ROOT_STORAGE_BASE,
+  };
+  IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+      arena, state.value_count, sizeof(*state.roots), (void**)&state.roots));
+  loom_pointer_roots_seed(&state, body);
+  // Optimistic fixpoint: roots only merge toward UNKNOWN, so this terminates.
+  do {
+    state.changed = false;
+    loom_block_t* block = NULL;
+    loom_region_for_each_block(body, block) {
+      loom_op_t* op = NULL;
+      loom_block_for_each_op(block, op) {
+        loom_pointer_roots_visit_op(&state, op);
+      }
+    }
+  } while (state.changed);
+  loom_block_t* block = NULL;
+  loom_region_for_each_block(body, block) {
+    loom_op_t* op = NULL;
+    loom_block_for_each_op(block, op) {
+      IREE_RETURN_IF_ERROR(loom_pointer_roots_summarize_op(
+          &state, op, address_field, arena, out_map));
+    }
+  }
+  return iree_ok_status();
+}
