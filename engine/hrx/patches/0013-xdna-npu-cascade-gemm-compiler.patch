+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD0_BUFFER_LENGTH,
+      encoded_length, &words[0]);
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD1_BASE_ADDRESS,
+      dma_address >> tile->dma.address_encoding_shift, &words[1]);
+  const uint16_t next_buffer_descriptor =
+      dma->buffer_descriptor_start +
+      (uint16_t)((slot_ordinal + 1) % dma->buffer_descriptor_count);
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD1_NEXT_BD,
+      next_buffer_descriptor, &words[1]);
+  // A grouped drain runs each group's descriptor as its own task; a streamed
+  // fill loops forever.
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD1_USE_NEXT_BD,
+      (replay && last_slot && !(stream && fill)) ||
+              (gated_drain && groups > 1)
+          ? 0
+          : 1,
+      &words[1]);
+  loom_aie2p_program_encode_admitted_field(
+      LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_BD_WORD7_VALID_BD, 1, &words[7]);
