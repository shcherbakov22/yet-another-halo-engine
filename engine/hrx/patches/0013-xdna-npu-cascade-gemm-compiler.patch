+// RUN: emit aie2p-array-plan @mismatched_multicast_stage
+
+// Every channel of a staged multicast uses the first channel's stage.
+aie2p.target<array> @array_target
+
+aie2p.target<core> @core_target
+
+low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @mismatched_multicast_stage() asm {
+  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
+  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
+  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
+  %workers = group %two
+  %first = worker %workers, %zero, @consume
+  %second = worker %workers, %one, @consume
+  %input = binding 0, "read"
+  %source = sender %input, 0 : reg<aie2p.array.sender : tile<2x64xi32>>
+  %origin = constant.u64 0 : reg<aie2p.array.offset : offset>
+  %record = view.sender %source, %origin : reg<aie2p.array.sender : tile<64xi32>>
+  %first_input = receiver %first, 0 : reg<aie2p.array.receiver : tile<64xi32>>
+  %second_input = receiver %second, 0 : reg<aie2p.array.receiver : tile<64xi32>>
+  %first_channel = channel %record, %first_input, %two, %two : reg<aie2p.array.channel : tile<64xi32>>
+  // ERROR@+1: XDNA/026 "must use the stage of its first channel"
+  %second_channel = channel %record, %second_input, %two, %two : reg<aie2p.array.channel : tile<64xi32>>
+  constrain.location %first, %zero, %two
+  constrain.location %second, %one, %two
+  constrain.stage %first_channel, %zero
+  constrain.stage %second_channel, %one
+  return
