+// A staged channel's memory-tile ring: one stream-to-memory and one
+// memory-to-stream DMA channel, a buffer descriptor per record on each, and a
+// credit/ready lock pair.
+static iree_status_t loom_aie2p_array_admit_memory_tile_cardinality(
+    loom_aie2p_array_plan_builder_t* builder, uint32_t channel_index,
+    loom_aie2p_array_physical_demands_t* demands,
+    loom_aie2p_array_physical_cardinalities_t* cardinalities) {
+  loom_aie2p_array_channel_t* channel = &builder->channels[channel_index];
+  // A binding with leading zero-stride (repeated) axes is read once into the
+  // memory tile, which replays it; otherwise the ring passes records through.
+  const loom_aie2p_array_endpoint_t* sender =
+      &builder->endpoints[channel->sender_endpoint_index];
+  const loom_aie2p_array_endpoint_t* base_sender =
+      loom_aie2p_array_topology_base_endpoint(builder->plan, sender);
+  const uint64_t repeat_count = loom_aie2p_array_binding_repeat_count(
+      builder->module, &builder->facts, base_sender->message_type,
+      sender->message_type, sender->binding_view_partitioned);
+  {
+    const loom_xdna_tile_coordinate_t stage = {channel->stage_column, 1};
+    // Each memory-tile DMA channel chains BDs within its parity half.
+    const uint32_t half_descriptor_count =
+        loom_xdna_array_tile_kind_facts(builder->family,
+                                        LOOM_XDNA_TILE_KIND_MEMORY)
+            ->dma.buffer_descriptor_count /
+        2u;
+    if (repeat_count > 1 &&
+        (channel->record_count % repeat_count != 0 || repeat_count > 256)) {
+      return loom_aie2p_array_reject_channel_resources(
+          builder, channel_index, stage,
+          IREE_SV("a replayed stage needs whole repetitions and at most 256 "
+                  "of them"));
+    }
+    uint64_t ring_record_count =
+        repeat_count > 1 ? channel->record_count / repeat_count
+                         : channel->capacity;
+    // Experimental: a deeper pass-through ring for leaf-synchronized channels,
+    // whose small records leave a capacity-deep stage little slack.
+    if (repeat_count <= 1 && channel->leaf_sync) {
+      const char* depth = getenv("LOOM_EXP_LS_STAGE_DEPTH");
+      if (depth != NULL && atoi(depth) > (int)ring_record_count) {
+        ring_record_count = (uint64_t)atoi(depth);
+      }
+    }
+    // A replayed panel longer than one descriptor half packs several channel
+    // records into each memory-tile record: the stream is continuous, so the
+    // receiving DMA still completes one descriptor per channel record.
+    uint32_t group = 1;
+    if (repeat_count > 1 && ring_record_count > half_descriptor_count) {
+      group = (uint32_t)((ring_record_count + half_descriptor_count - 1) /
+                         half_descriptor_count);
+      while (group <= ring_record_count && ring_record_count % group != 0) {
+        ++group;
+      }
+      ring_record_count /= group;
+    }
+    channel->stage_group = group;
+    const loom_xdna_dma_facts_t* stage_dma =
+        &loom_xdna_array_tile_kind_facts(builder->family,
+                                         LOOM_XDNA_TILE_KIND_MEMORY)
+             ->dma;
+    const uint64_t stage_units = (uint64_t)group * channel->record_byte_length /
+                                 stage_dma->transfer_length_granularity;
+    if (stage_units < iree_max(1u, stage_dma->transfer_length_offset) ||
+        stage_units > (uint64_t)stage_dma->maximum_encoded_transfer_length +
+                          stage_dma->transfer_length_offset) {
+      return loom_aie2p_array_reject_channel_resources(
+          builder, channel_index, stage,
+          IREE_SV("a grouped memory-tile record exceeds the descriptor length "
+                  "field"));
+    }
+    channel->stage_encoded_length =
+        (uint32_t)(stage_units - stage_dma->transfer_length_offset);
+    if (ring_record_count > half_descriptor_count) {
+      return loom_aie2p_array_reject_channel_resources(
+          builder, channel_index, stage,
+          IREE_SV("a staged ring (one repetition when replaying) needs one "
+                  "buffer descriptor per record within a memory-tile "
+                  "descriptor half"));
+    }
+    channel->stage_repeat_count = (uint32_t)repeat_count;
+    channel->stage_record_count = (uint32_t)ring_record_count;
+  }
+  const loom_xdna_tile_resource_totals_t* totals =
+      &loom_xdna_array_tile_kind_facts(builder->family,
+                                       LOOM_XDNA_TILE_KIND_MEMORY)
+           ->array_resources;
+  const loom_xdna_tile_coordinate_t coordinate = {channel->stage_column, 1};
+  if (demands->memory_tile_dma_channels ==
+      totals->dma_channel_count_per_direction) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, coordinate,
+        IREE_SV("the array has no remaining memory-tile DMA channel pair"));
+  }
+  if (totals->dma_buffer_descriptor_count -
+          demands->memory_tile_buffer_descriptors <
+      2u * channel->stage_record_count) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, coordinate,
+        IREE_SV("the array has too few remaining memory-tile DMA buffer "
+                "descriptors for the staged ring"));
+  }
+  if (totals->lock_count - demands->memory_tile_locks < 2u) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, coordinate,
+        IREE_SV("the array has fewer than two remaining memory-tile "
+                "synchronization locks"));
+  }
+  ++demands->memory_tile_dma_channels;
+  demands->memory_tile_buffer_descriptors += 2u * channel->stage_record_count;
+  demands->memory_tile_locks += 2u;
+  cardinalities->dma_channel_count += 2u;
+  cardinalities->lock_count += 2u;
+  cardinalities->stage_record_count += channel->stage_record_count;
+  return iree_ok_status();
+}
+
+// Experimental: LOOM_EXP_PANEL_GROUPS="2,3" replays each shared panel slice
+// of 2 + 3 records in two groups. Returns the group count (1 when unset or
+// when the groups do not sum to |records|).
+static uint8_t loom_aie2p_array_panel_groups(uint64_t records,
+                                             uint8_t out_records[4]) {
+  const char* spec = getenv("LOOM_EXP_PANEL_GROUPS");
+  if (spec == NULL) return 1;
+  uint8_t count = 0;
+  uint64_t total = 0;
+  const char* cursor = spec;
+  while (*cursor != 0 && count < 4) {
+    char* end = NULL;
+    const long value = strtol(cursor, &end, 10);
+    if (end == cursor || value <= 0 || value > 255) return 1;
+    out_records[count++] = (uint8_t)value;
+    total += (uint64_t)value;
+    if (*end != ',' && *end != 0) return 1;
+    cursor = *end == ',' ? end + 1 : end;
+  }
+  return total == records && *cursor == 0 && count > 1 ? count : 1;
+}
+
+static bool loom_aie2p_array_panel_stream(void) {
+  const char* value = getenv("LOOM_EXP_PANEL_STREAM");
+  return value != NULL && atoi(value) != 0;
+}
+
+// Group count of a shared panel member's slice (see panel_groups).
+static uint32_t loom_aie2p_array_panel_group_count(
+    loom_aie2p_array_plan_builder_t* builder,
+    const loom_aie2p_array_channel_t* member) {
+  const loom_aie2p_array_endpoint_t* sender =
+      &builder->endpoints[member->sender_endpoint_index];
+  const loom_aie2p_array_endpoint_t* base_sender =
+      loom_aie2p_array_topology_base_endpoint(builder->plan, sender);
+  const uint64_t repeat_count = loom_aie2p_array_binding_repeat_count(
+      builder->module, &builder->facts, base_sender->message_type,
+      sender->message_type, sender->binding_view_partitioned);
+  if (repeat_count <= 1 || member->record_count % repeat_count != 0) return 1;
+  uint8_t records[4];
+  return loom_aie2p_array_panel_groups(member->record_count / repeat_count,
+                                       records);
+}
+
+// A shared memory-tile panel: the owner's fill loads every member's slice
+// once (one memory-tile record per slice, sized to the largest) and each
+// member drains its own slice through one descriptor, replaying it. Member
+// slices must be dense and tile the panel contiguously in binding order.
+static iree_status_t loom_aie2p_array_admit_memory_tile_panel(
+    loom_aie2p_array_plan_builder_t* builder, uint32_t owner_index,
+    loom_aie2p_array_physical_demands_t* demands,
+    loom_aie2p_array_physical_cardinalities_t* cardinalities) {
+  loom_aie2p_array_channel_t* owner = &builder->channels[owner_index];
+  const loom_xdna_tile_coordinate_t stage = {owner->stage_column, 1};
+  const loom_xdna_dma_facts_t* stage_dma =
+      &loom_xdna_array_tile_kind_facts(builder->family,
+                                       LOOM_XDNA_TILE_KIND_MEMORY)
+           ->dma;
+  uint64_t base = UINT64_MAX;
+  uint64_t largest = 0;
+  uint32_t member_count = 0;
+  for (iree_host_size_t i = 0; i < builder->plan->channel_count; ++i) {
+    loom_aie2p_array_channel_t* member = &builder->channels[i];
+    if (member->stage_panel_owner != owner_index) continue;
+    const loom_aie2p_array_endpoint_t* sender =
+        &builder->endpoints[member->sender_endpoint_index];
+    const loom_aie2p_array_endpoint_t* base_sender =
+        loom_aie2p_array_topology_base_endpoint(builder->plan, sender);
+    const uint64_t repeat_count = loom_aie2p_array_binding_repeat_count(
+        builder->module, &builder->facts, base_sender->message_type,
+        sender->message_type, sender->binding_view_partitioned);
+    if (repeat_count <= 1 || member->record_count % repeat_count != 0 ||
+        repeat_count > 256) {
+      return loom_aie2p_array_reject_channel_resources(
+          builder, (uint32_t)i, stage,
+          IREE_SV("a shared memory-tile panel member must replay whole "
+                  "repetitions, at most 256 of them"));
+    }
+    const uint64_t records = member->record_count / repeat_count;
+    const uint64_t length = records * member->record_byte_length;
+    const uint64_t units = length / stage_dma->transfer_length_granularity;
+    if (length % stage_dma->transfer_length_granularity != 0 ||
+        units < iree_max(1u, stage_dma->transfer_length_offset) ||
+        units > (uint64_t)stage_dma->maximum_encoded_transfer_length +
+                    stage_dma->transfer_length_offset) {
+      return loom_aie2p_array_reject_channel_resources(
+          builder, (uint32_t)i, stage,
+          IREE_SV("a shared memory-tile panel slice exceeds the descriptor "
+                  "length field"));
+    }
+    member->stage_repeat_count = (uint32_t)repeat_count;
+    member->stage_group = (uint32_t)records;
+    member->stage_encoded_length =
+        (uint32_t)(units - stage_dma->transfer_length_offset);
+    member->stage_panel_group_count = loom_aie2p_array_panel_groups(
+        records, member->stage_panel_group_records);
+    member->stage_panel_stream = member->stage_panel_group_count > 1 &&
+                                 loom_aie2p_array_panel_stream();
+    if (member->stage_panel_group_count > 1 && repeat_count > 63) {
+      return loom_aie2p_array_reject_channel_resources(
+          builder, (uint32_t)i, stage,
+          IREE_SV("a grouped shared panel replays at most 63 times"));
+    }
+    base = iree_min(base, sender->binding_byte_offset);
+    largest = iree_max(largest, length);
+    ++member_count;
+  }
+  // Slots follow binding order; slices must abut.
+  uint64_t cursor = base;
+  for (uint32_t slot = 0; slot < member_count; ++slot) {
+    loom_aie2p_array_channel_t* next = NULL;
+    for (iree_host_size_t i = 0; i < builder->plan->channel_count; ++i) {
+      loom_aie2p_array_channel_t* member = &builder->channels[i];
+      if (member->stage_panel_owner == owner_index &&
+          builder->endpoints[member->sender_endpoint_index]
+                  .binding_byte_offset == cursor) {
+        next = member;
+        break;
+      }
+    }
+    if (next == NULL) {
+      return loom_aie2p_array_reject_channel_resources(
+          builder, owner_index, stage,
+          IREE_SV("shared memory-tile panel slices must tile the panel "
+                  "contiguously"));
+    }
+    next->stage_panel_slot = slot;
+    next->stage_panel_byte_offset = cursor - base;
+    cursor += (uint64_t)next->stage_group * next->record_byte_length;
+  }
+  const uint32_t groups = owner->stage_panel_group_count;
+  const uint32_t half_descriptor_count = stage_dma->buffer_descriptor_count / 2u;
+  if (groups * member_count > half_descriptor_count) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, owner_index, stage,
+        IREE_SV("a shared memory-tile panel needs its slices within one "
+                "memory-tile descriptor half"));
+  }
+  owner->stage_record_count = member_count;
+  owner->stage_panel_record_bytes = (uint32_t)largest;
+  if (owner->stage_panel_stream && !builder->plan->stream_panels) {
+    builder->plan->stream_panels = true;
+    for (uint32_t g = 0; g < 4; ++g) builder->plan->stream_pace[g] = 1;
