+      &loom_xdna_array_tile_facts(plan->family, dma->coordinate)->dma;
+  // A grouped panel: fill descriptor (group g, member slot m) at g * members +
+  // m, a drain descriptor per group; each group is a slice of the member's
+  // memory-tile record, gated by the member's group lock pair.
+  const uint32_t members =
+      groups > 1 && fill ? dma->buffer_descriptor_count / groups : 1u;
+  const uint32_t group =
+      groups > 1 ? (fill ? slot_ordinal / members : slot_ordinal) : 0u;
+  if (fill && channel->stage_panel_owner == dma->channel_index) {
+    // A shared panel's fill writes each slot with its member's slice length
+    // and releases the ready lock of the member draining it.
+    const uint32_t member_slot =
+        groups > 1 ? slot_ordinal % members : slot_ordinal;
+    for (iree_host_size_t i = 0; i < plan->channel_count; ++i) {
+      const loom_aie2p_array_channel_t* member = &plan->channels[i];
+      if (member->stage_panel_owner == dma->channel_index &&
+          member->stage_panel_slot == member_slot) {
+        release_lock =
+            &plan->locks[member->stage_panel_lock_index + 2u * group + 1u];
+        encoded_length = member->stage_encoded_length;
+        if (groups > 1) {
+          for (uint32_t g = 0; g < group; ++g) {
+            record_byte_offset += (uint32_t)(member->stage_panel_group_records[g] *
+                                             member->record_byte_length);
+          }
+          encoded_length =
