+// One streamed push on parity |parity|: the replay drains of every streamed
+// panel member, the shim tasks of every other binding, then the panel fills
+// group by group, stream_pace[group] owners at a time, each wave retired by
+// its completion tokens before the next (the fills then share DRAM with the
+// activation streams instead of starving them).
+static iree_status_t loom_aie2p_program_build_stream_push(
+    loom_aie2p_array_program_builder_t* builder, uint32_t parity) {
+  const loom_aie2p_array_plan_t* plan = builder->plan;
+  for (iree_host_size_t i = 0; i < plan->dma_channel_count; ++i) {
+    const loom_aie2p_array_dma_plan_t* dma = &plan->dma_channels[i];
+    if (!loom_aie2p_program_is_memory_tile_dma(dma) ||
+        dma->direction != LOOM_AIE2P_ARRAY_DMA_DIRECTION_MEMORY_TO_STREAM) {
+      continue;
+    }
+    const loom_aie2p_array_channel_t* channel =
+        &plan->channels[dma->channel_index];
+    if (channel->stage_panel_owner == UINT32_MAX ||
+        !channel->stage_panel_stream || channel->stage_repeat_count <= 1) {
+      continue;
+    }
+    const uint16_t indices[] = {dma->dma_channel};
+    for (uint32_t g = 0; g < channel->stage_panel_group_count; ++g) {
+      loom_aie2p_register_update_t task = {0};
+      IREE_RETURN_IF_ERROR(loom_aie2p_program_resolve_field_update(
+          plan,
+          LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_CHANNEL_MM2S_START_QUEUE_START_BD_ID,
+          dma->coordinate, IREE_ARRAYSIZE(indices), indices,
+          dma->buffer_descriptor_start + g, &task));
+      loom_aie2p_register_update_t repeat = {0};
+      IREE_RETURN_IF_ERROR(loom_aie2p_program_resolve_field_update(
+          plan,
+          LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_CHANNEL_MM2S_START_QUEUE_REPEAT_COUNT,
+          dma->coordinate, IREE_ARRAYSIZE(indices), indices,
+          channel->stage_repeat_count - 1u, &repeat));
+      IREE_RETURN_IF_ERROR(
+          loom_aie2p_program_merge_register_update(&repeat, &task));
