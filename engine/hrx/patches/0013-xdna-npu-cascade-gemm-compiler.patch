+  const loom_aie2p_array_lock_plan_t* acquire_lock =
+      fill ? credit_lock : ready_lock;
+  const loom_aie2p_array_lock_plan_t* release_lock =
+      fill ? ready_lock : credit_lock;
+  uint32_t encoded_length = channel->stage_encoded_length;
+  uint32_t record_slot = slot_ordinal;
+  uint32_t record_byte_offset = 0;
+  const uint32_t groups = channel->stage_panel_owner != UINT32_MAX
+                              ? channel->stage_panel_group_count
+                              : 1u;
+  const bool stream = groups > 1 && channel->stage_panel_stream;
+  // Lock values: a streamed fill takes a whole panel of credits and releases
+  // as many replays; each streamed replay takes one ready and returns one
+  // credit (its own pair's credit lock).
+  int32_t acquire_value = -1;
+  int32_t release_value = 1;
