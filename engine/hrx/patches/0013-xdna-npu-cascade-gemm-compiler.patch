+static iree_status_t loom_aie2p_program_start_memory_tile_dma(
+    loom_aie2p_array_program_builder_t* builder,
+    const loom_aie2p_array_dma_plan_t* dma) {
+  const uint16_t indices[] = {dma->dma_channel};
+  loom_aie2p_register_update_t queue = {0};
+  const bool drain =
+      dma->direction == LOOM_AIE2P_ARRAY_DMA_DIRECTION_MEMORY_TO_STREAM;
+  IREE_RETURN_IF_ERROR(loom_aie2p_program_resolve_field_update(
+      builder->plan,
+      drain
+          ? LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_CHANNEL_MM2S_START_QUEUE_START_BD_ID
+          : LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_CHANNEL_S2MM_START_QUEUE_START_BD_ID,
+      dma->coordinate, IREE_ARRAYSIZE(indices), indices,
+      dma->buffer_descriptor_start, &queue));
+  const loom_aie2p_array_channel_t* channel =
+      &builder->plan->channels[dma->channel_index];
+  // A replaying ring fills once and its drains end with the invocation, so the
+  // control program re-arms it: every invocation, including the control-only
+  // continuation, restores the ring's locks and restarts its queue.
+  const bool replay = channel->stage_repeat_count > 1;
+  const uint32_t groups = channel->stage_panel_owner != UINT32_MAX
+                              ? channel->stage_panel_group_count
+                              : 1u;
+  const bool stream = groups > 1 && channel->stage_panel_stream;
+  // A streamed panel's fill starts once with the array (its chain loops); its
+  // locks are initialized once with the array and never restored.
+  loom_aie2p_program_record_builder_t* records =
+      replay && !(stream && !drain) ? &builder->control : &builder->array;
+  if (replay && !stream) {
+    for (uint32_t g = 0; g < groups; ++g) {
+      IREE_RETURN_IF_ERROR(loom_aie2p_program_append_lock_initialization(
+          builder, records,
+          &builder->plan->locks[dma->credit_lock_index + 2u * g]));
+      IREE_RETURN_IF_ERROR(loom_aie2p_program_append_lock_initialization(
+          builder, records,
+          &builder->plan->locks[dma->credit_lock_index + 2u * g + 1u]));
+    }
+  }
+  if (drain && replay && stream) {
+    return iree_ok_status();   // queued by each streamed push
+  }
+  if (drain && replay && groups > 1) {
+    // One task per group, queued in order: each replays its group descriptor.
+    for (uint32_t g = 0; g < groups; ++g) {
+      loom_aie2p_register_update_t task = {0};
+      IREE_RETURN_IF_ERROR(loom_aie2p_program_resolve_field_update(
+          builder->plan,
+          LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_CHANNEL_MM2S_START_QUEUE_START_BD_ID,
+          dma->coordinate, IREE_ARRAYSIZE(indices), indices,
+          dma->buffer_descriptor_start + g, &task));
+      loom_aie2p_register_update_t repeat = {0};
+      IREE_RETURN_IF_ERROR(loom_aie2p_program_resolve_field_update(
+          builder->plan,
+          LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_CHANNEL_MM2S_START_QUEUE_REPEAT_COUNT,
+          dma->coordinate, IREE_ARRAYSIZE(indices), indices,
+          channel->stage_repeat_count - 1u, &repeat));
+      IREE_RETURN_IF_ERROR(
+          loom_aie2p_program_merge_register_update(&repeat, &task));
+      loom_aie2p_program_append_register_write32(records, task.address,
+                                                 task.value);
+    }
+    return iree_ok_status();
+  }
+  if (drain && replay) {
+    loom_aie2p_register_update_t repeat = {0};
+    IREE_RETURN_IF_ERROR(loom_aie2p_program_resolve_field_update(
+        builder->plan,
+        LOOM_XDNA_REGISTER_FIELD_MEMORY_TILE_DMA_CHANNEL_MM2S_START_QUEUE_REPEAT_COUNT,
+        dma->coordinate, IREE_ARRAYSIZE(indices), indices,
+        channel->stage_repeat_count - 1u, &repeat));
+    IREE_RETURN_IF_ERROR(loom_aie2p_program_merge_register_update(&repeat,
+                                                                   &queue));
+  }
+  loom_aie2p_program_append_register_write32(records, queue.address,
+                                             queue.value);
+  return iree_ok_status();
+}
