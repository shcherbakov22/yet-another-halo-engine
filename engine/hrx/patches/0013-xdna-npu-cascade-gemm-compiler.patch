+// ====
+
+// RUN: emit aie2p-array-plan @egress_stage
+
+// Only binding-to-worker ingress channels can be staged.
+aie2p.target<array> @array_target
+
+aie2p.target<core> @core_target
+
+low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @egress_stage() asm {
+  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
+  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
+  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
+  %workers = group %one
+  %worker = worker %workers, %zero, @produce
+  %output = binding 0, "write"
+  %worker_output = sender %worker, 0 : reg<aie2p.array.sender : tile<64xi32>>
+  %sink = receiver %output, 0 : reg<aie2p.array.receiver : tile<2x64xi32>>
+  %origin = constant.u64 0 : reg<aie2p.array.offset : offset>
+  %sink_record = view.receiver %sink, %origin : reg<aie2p.array.receiver : tile<64xi32>>
