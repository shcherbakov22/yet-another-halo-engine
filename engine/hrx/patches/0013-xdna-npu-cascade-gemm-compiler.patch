+        builder, binding_plan, dma, descriptor, 0,
+        binding_plan->transfer_byte_length);
+    loom_aie2p_program_build_shim_dma_queue_at(builder, binding_plan, dma,
+                                               descriptor, NULL);
+  }
+  for (uint32_t g = 0; g < group_count; ++g) {
+    const uint32_t pace = plan->stream_pace[g < 4 ? g : 3];
+    iree_host_size_t wave_start = 0;
+    while (wave_start < plan->binding_plan_count) {
+      iree_host_size_t wave[8];
+      uint32_t wave_count = 0;
+      iree_host_size_t i = wave_start;
+      for (; i < plan->binding_plan_count && wave_count < pace; ++i) {
+        const loom_aie2p_array_dma_plan_t* dma =
+            &plan->dma_channels[plan->binding_plans[i].dma_index];
+        if (loom_aie2p_program_stream_owner(plan, dma) != NULL) {
+          wave[wave_count++] = i;
+        }
+      }
+      wave_start = i;
+      for (uint32_t w = 0; w < wave_count; ++w) {
+        const loom_aie2p_array_binding_plan_t* binding_plan =
+            &plan->binding_plans[wave[w]];
+        const loom_aie2p_array_dma_plan_t* dma =
+            &plan->dma_channels[binding_plan->dma_index];
+        const loom_aie2p_array_channel_t* owner =
+            loom_aie2p_program_stream_owner(plan, dma);
+        const loom_aie2p_array_completion_route_t* route =
+            loom_aie2p_program_tile_completion_route(plan, dma->coordinate);
+        if (route == NULL) {
+          return iree_make_status(
+              IREE_STATUS_FAILED_PRECONDITION,
+              "a streamed panel fill needs an egress completion route on its "
+              "shim tile");
+        }
+        uint32_t offset = 0;
+        uint32_t length = 0;
+        loom_aie2p_program_stream_group_span(plan, dma->channel_index, g,
+                                             &offset, &length);
+        const uint16_t descriptor =
+            (uint16_t)(dma->buffer_descriptor_start +
+                       parity * owner->stage_panel_group_count + g);
+        loom_aie2p_program_build_shim_dma_descriptor_at(
+            builder, binding_plan, dma, descriptor, offset, length);
+        loom_aie2p_program_build_shim_dma_queue_at(builder, binding_plan, dma,
+                                                   descriptor, route);
+      }
+      for (uint32_t w = 0; w < wave_count; ++w) {
+        const loom_aie2p_array_dma_plan_t* dma =
+            &plan->dma_channels[plan->binding_plans[wave[w]].dma_index];
+        loom_aie2p_program_append_dma_task_wait(&builder->control,
+                                                dma->coordinate, dma->direction,
+                                                dma->dma_channel);
+      }
+    }
+  }
+  return iree_ok_status();
+}
