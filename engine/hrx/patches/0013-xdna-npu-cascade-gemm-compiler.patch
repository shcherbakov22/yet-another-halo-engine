+// Memory-tile staging of an ingress channel: one ring in the stage column's
+// memory tile, filled by a stream-to-memory DMA channel and drained by a
+// memory-to-stream DMA channel sharing its credit/ready lock pair. Both DMA
+// rows are appended consecutively; the ring records land in stage_storage of
+// the channel's slots.
+static iree_status_t loom_aie2p_array_plan_stage(
+    loom_aie2p_array_plan_builder_t* builder, uint32_t channel_index) {
+  loom_aie2p_array_channel_t* channel = &builder->channels[channel_index];
+  const loom_xdna_tile_coordinate_t coordinate = {channel->stage_column, 1};
+  loom_aie2p_array_tile_state_t* state =
+      loom_aie2p_array_tile_state(builder, coordinate);
+  loom_aie2p_array_tile_resources_t* resources = &state->resources;
+  const uint16_t record_count = (uint16_t)channel->stage_record_count;
+  // Ring storage and the credit/ready lock pair.
+  loom_aie2p_array_ring_resource_proposal_t ring = {0};
+  if (loom_aie2p_array_channel_resources_propose_neighbor(
+          resources, coordinate, /*load_address_base=*/0, (uint8_t)record_count,
+          channel->stage_panel_owner == channel_index
+              ? channel->stage_panel_record_bytes
+              : channel->record_byte_length * channel->stage_group,
+          &ring) != LOOM_AIE2P_ARRAY_CHANNEL_RESOURCE_FAILURE_NONE) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, coordinate,
+        IREE_SV("the stage memory tile cannot host the staged ring and its "
+                "lock pair"));
+  }
+  // Fill and drain channels of opposite parity, so each owns a BD half. Skip
+  // a drain channel when one is free, else a fill channel.
+  uint8_t fill_channel = resources->next_stream_to_memory_channel;
+  uint8_t drain_channel = resources->next_memory_to_stream_channel;
+  if ((drain_channel & 1u) == (fill_channel & 1u)) {
+    if (drain_channel + 1u < resources->facts->dma.channel_count_per_direction) {
+      ++drain_channel;
+    } else {
+      ++fill_channel;
+    }
+  }
+  const uint16_t half_capacity =
+      (uint16_t)(resources->facts->dma.buffer_descriptor_count / 2u);
+  // A shared panel's owner drains only its own slice (a descriptor per
+  // group); its fill writes every member's slice, a descriptor per group.
+  const bool panel = channel->stage_panel_owner == channel_index;
+  const uint16_t groups = panel ? channel->stage_panel_group_count : 1u;
+  const uint16_t fill_count = (uint16_t)(groups * record_count);
+  const uint16_t drain_count = panel ? groups : record_count;
+  uint16_t* fill_cursor = &state->memory_tile_bd_cursors[fill_channel & 1u];
+  uint16_t* drain_cursor = &state->memory_tile_bd_cursors[drain_channel & 1u];
+  if (fill_channel >= resources->facts->dma.channel_count_per_direction ||
+      drain_channel >= resources->facts->dma.channel_count_per_direction ||
+      *fill_cursor + fill_count > half_capacity ||
+      *drain_cursor + drain_count > half_capacity) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, coordinate,
+        IREE_SV("the stage memory tile has no DMA channel pair with enough "
+                "buffer descriptors in their descriptor halves"));
+  }
+  loom_aie2p_array_channel_resources_commit_ring(&ring, resources);
+  resources->next_stream_to_memory_channel = fill_channel + 1u;
+  resources->next_memory_to_stream_channel = drain_channel + 1u;
+  const uint16_t fill_bd = (uint16_t)((fill_channel & 1u) * half_capacity +
+                                      *fill_cursor);
+  *fill_cursor += fill_count;
+  const uint16_t drain_bd = (uint16_t)((drain_channel & 1u) * half_capacity +
+                                       *drain_cursor);
+  *drain_cursor += drain_count;
+  const uint32_t credit_lock_index = loom_aie2p_array_append_lock_pair(
+      builder, channel_index, LOOM_AIE2P_ARRAY_ENDPOINT_DIRECTION_RECEIVE,
+      &ring);
+  if (groups > 1) {
+    // Every fill descriptor takes one credit; later groups gate the owner's
+    // own drains through the lock pairs that follow.
+    builder->locks[credit_lock_index].initial_value = (int8_t)fill_count;
+    if ((uint16_t)resources->next_lock + 2u * (groups - 1u) >
+        resources->facts->lock_count) {
+      return loom_aie2p_array_reject_channel_resources(
+          builder, channel_index, coordinate,
+          IREE_SV("the stage memory tile has no free lock pairs for the "
+                  "panel groups"));
+    }
+    for (uint16_t g = 1; g < groups; ++g) {
+      const loom_aie2p_array_ring_resource_proposal_t pair = {
+          .coordinate = coordinate,
+          .credit_lock = resources->next_lock,
+          .ready_lock = (uint8_t)(resources->next_lock + 1u),
+      };
+      resources->next_lock += 2u;
+      loom_aie2p_array_append_lock_pair(
+          builder, channel_index, LOOM_AIE2P_ARRAY_ENDPOINT_DIRECTION_RECEIVE,
+          &pair);
+    }
+    if (channel->stage_panel_stream) {
+      // Counting locks: each group pair starts with one full panel of credits.
+      for (uint16_t g = 0; g < groups; ++g) {
+        builder->locks[credit_lock_index + 2u * g].initial_value =
+            (int8_t)channel->stage_repeat_count;
+      }
+    }
+  }
+  channel->stage_dma_index = (uint32_t)builder->dma_channel_cursor;
+  builder->dma_channels[builder->dma_channel_cursor++] =
+      (loom_aie2p_array_dma_plan_t){
+          .channel_index = channel_index,
+          .coordinate = coordinate,
+          .direction = LOOM_AIE2P_ARRAY_DMA_DIRECTION_STREAM_TO_MEMORY,
+          .dma_channel = fill_channel,
+          .flags = LOOM_AIE2P_ARRAY_DMA_FLAG_MEMORY_TILE,
+          .buffer_descriptor_start = fill_bd,
+          .buffer_descriptor_count = fill_count,
+          .credit_lock_index = credit_lock_index,
+          .stage_record_base = (uint32_t)builder->stage_record_cursor,
+          .gate_count = fill_count,
+      };
+  builder->dma_channels[builder->dma_channel_cursor++] =
+      (loom_aie2p_array_dma_plan_t){
+          .channel_index = channel_index,
+          .coordinate = coordinate,
+          .direction = LOOM_AIE2P_ARRAY_DMA_DIRECTION_MEMORY_TO_STREAM,
+          .dma_channel = drain_channel,
+          .flags = LOOM_AIE2P_ARRAY_DMA_FLAG_MEMORY_TILE,
+          .buffer_descriptor_start = drain_bd,
+          .buffer_descriptor_count = drain_count,
+          .credit_lock_index = credit_lock_index,
+          .stage_record_base = (uint32_t)builder->stage_record_cursor +
+                               (panel ? channel->stage_panel_slot : 0u),
+          .gate_count = panel ? 1u : record_count,
+      };
+  if (panel && groups > 1) {
+    builder->dma_channels[builder->dma_channel_cursor - 1].buffer_descriptor_count =
+        drain_count;
+  }
+  if (panel) {
+    channel->stage_panel_lock_index = credit_lock_index;
+  }
+  channel->stage_first_record = (uint32_t)builder->stage_record_cursor;
+  for (uint32_t record = 0; record < record_count; ++record) {
+    builder->stage_record_offsets[builder->stage_record_cursor++] =
+        ring.owner_offsets[record];
+  }
+  return iree_ok_status();
+}
+
+// A shared panel follower drains its slice of the owner's resident panel
+// through one descriptor on the owner's memory tile, gated on the owner's fill.
+// A binding multicast whose destination workers all sit in one row climbs
+// once and fans out along that row.
+static bool loom_aie2p_array_multicast_shares_row(
+    const loom_aie2p_array_plan_builder_t* builder, uint32_t channel_index) {
+  const loom_aie2p_array_channel_t* channel = &builder->channels[channel_index];
+  const uint32_t source = channel->source_channel_index;
+  uint32_t branch_count = 0;
+  uint16_t row = UINT16_MAX;
+  for (iree_host_size_t i = 0; i < builder->plan->channel_count; ++i) {
+    const loom_aie2p_array_channel_t* other = &builder->channels[i];
+    if (other->source_channel_index != source) continue;
+    const loom_aie2p_array_endpoint_t* receiver =
+        &builder->endpoints[other->receiver_endpoint_index];
+    if (receiver->owner_kind != LOOM_AIE2P_ARRAY_ENDPOINT_OWNER_WORKER) {
+      return false;
+    }
+    const uint16_t worker_row =
+        builder->workers[receiver->owner_index].coordinate.row;
+    if (row != UINT16_MAX && worker_row != row) return false;
+    row = worker_row;
+    ++branch_count;
+  }
+  return branch_count > 1;
+}
+
+static iree_status_t loom_aie2p_array_plan_panel_drain(
+    loom_aie2p_array_plan_builder_t* builder, uint32_t channel_index) {
+  loom_aie2p_array_channel_t* channel = &builder->channels[channel_index];
+  const loom_aie2p_array_channel_t* owner =
+      &builder->channels[channel->stage_panel_owner];
+  IREE_ASSERT_NE(owner->stage_dma_index, UINT32_MAX);
+  const loom_aie2p_array_dma_plan_t* owner_fill =
+      &builder->dma_channels[owner->stage_dma_index];
+  const loom_xdna_tile_coordinate_t coordinate = owner_fill->coordinate;
+  loom_aie2p_array_tile_state_t* state =
+      loom_aie2p_array_tile_state(builder, coordinate);
+  loom_aie2p_array_tile_resources_t* resources = &state->resources;
+  const uint8_t drain_channel = resources->next_memory_to_stream_channel;
+  const uint16_t half_capacity =
+      (uint16_t)(resources->facts->dma.buffer_descriptor_count / 2u);
+  uint16_t* drain_cursor = &state->memory_tile_bd_cursors[drain_channel & 1u];
+  const uint16_t groups = channel->stage_panel_group_count;
+  if (drain_channel >= resources->facts->dma.channel_count_per_direction ||
+      *drain_cursor + groups > half_capacity) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, coordinate,
+        IREE_SV("the shared panel memory tile has no free drain channel with "
+                "a buffer descriptor"));
+  }
+  if ((uint16_t)resources->next_lock + 2u * groups >
+      resources->facts->lock_count) {
+    return loom_aie2p_array_reject_channel_resources(
+        builder, channel_index, coordinate,
+        IREE_SV("the shared panel memory tile has no free lock pair"));
+  }
+  resources->next_memory_to_stream_channel = drain_channel + 1u;
+  const uint16_t drain_bd = (uint16_t)((drain_channel & 1u) * half_capacity +
+                                       *drain_cursor);
+  *drain_cursor += groups;
+  for (uint16_t g = 0; g < groups; ++g) {
+    const loom_aie2p_array_ring_resource_proposal_t lock_pair = {
+        .coordinate = coordinate,
+        .credit_lock = resources->next_lock,
+        .ready_lock = (uint8_t)(resources->next_lock + 1u),
+    };
+    resources->next_lock += 2u;
+    const uint32_t lock_index = loom_aie2p_array_append_lock_pair(
+        builder, channel_index, LOOM_AIE2P_ARRAY_ENDPOINT_DIRECTION_RECEIVE,
+        &lock_pair);
+    if (channel->stage_panel_stream) {
+      builder->locks[lock_index].initial_value =
+          (int8_t)channel->stage_repeat_count;
+    }
+    if (g == 0) channel->stage_panel_lock_index = lock_index;
+  }
+  channel->stage_first_record =
+      owner->stage_first_record + channel->stage_panel_slot;
+  channel->stage_record_count = 1u;
+  channel->stage_dma_index = (uint32_t)builder->dma_channel_cursor;
