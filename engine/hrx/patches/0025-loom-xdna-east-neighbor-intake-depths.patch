               receiver_worker->coordinate.column &&
           (row_delta == -1 || row_delta == 1);
+      // The receiver east of the sender loads the sender's memory through its
+      // west window (a core sees its own, north, south and west memory).
+      const bool receiver_is_east_neighbor =
+          row_delta == 0 && (int)receiver_worker->coordinate.column ==
+                                (int)sender_worker->coordinate.column + 1;
       // a core stream between two workers is a route (no memory, no DMA)
-      if (workers_are_vertical_neighbors && !channel->core_stream) {
+      if ((workers_are_vertical_neighbors || receiver_is_east_neighbor) &&
+          !channel->core_stream) {
         channel->transport = LOOM_AIE2P_ARRAY_CHANNEL_TRANSPORT_NEIGHBOR_MEMORY;
         channel->neighbor_receiver_load_address_base =
             loom_aie2p_array_topology_neighbor_load_address_base(
