   for (iree_host_size_t i = 0; i < builder->plan->worker_plan_count; ++i) {
@@ -2401,6 +2446,9 @@ static iree_status_t loom_aie2p_program_build_array(
       builder, LOOM_AIE2P_COMPUTE_DMA_RESET_ASSERTED));
   IREE_RETURN_IF_ERROR(loom_aie2p_program_append_memory_tile_dma_resets(
       builder, LOOM_AIE2P_COMPUTE_DMA_RESET_ASSERTED));
+  if (getenv("LOOM_EXP_ROUTE_RESET")) {
+    IREE_RETURN_IF_ERROR(loom_aie2p_program_drain_lock_requests(builder));
+  }
