+// LOOM_EXP_ROUTE_RESET: raises every lock of the core and memory tiles in the
+// image's columns to its maximum before the lock initialization. A core reset
+// does not withdraw an acquire the core was stalled in: the request stays
+// pending in the lock's module (also a neighbor's: a core stalled on its west
+// neighbor's lock) and takes the first token that lock receives under the next
+// image, where the same lock may belong to another channel (a record lost, the
+// consumer stalls). The raised value grants every such request while all cores
+// and tile DMAs are held in reset; the initialization then writes the real
+// values.
+static iree_status_t loom_aie2p_program_drain_lock_requests(
+    loom_aie2p_array_program_builder_t* builder) {
+  const loom_aie2p_array_plan_t* plan = builder->plan;
+  const loom_xdna_array_family_t* family = plan->family;
+  uint16_t columns = 0;
+  for (iree_host_size_t i = 0; i < plan->route_count; ++i) {
+    columns = iree_max(columns, (uint16_t)(plan->routes[i].coordinate.column + 1));
+  }
+  for (iree_host_size_t i = 0; i < plan->worker_plan_count; ++i) {
+    columns = iree_max(columns,
+                       (uint16_t)(plan->worker_plans[i].coordinate.column + 1));
+  }
+  for (uint16_t column = 0; column < columns; ++column) {
+    for (uint16_t row = 0; row < family->row_count; ++row) {
+      const loom_xdna_tile_coordinate_t coordinate = {.column = column,
+                                                      .row = row};
+      const loom_xdna_tile_facts_t* tile =
+          loom_xdna_array_tile_facts(family, coordinate);
+      if (!tile || (tile->kind != LOOM_XDNA_TILE_KIND_COMPUTE &&
+                    tile->kind != LOOM_XDNA_TILE_KIND_MEMORY)) {
+        continue;
+      }
+      for (uint16_t lock = 0; lock < tile->lock_count; ++lock) {
+        const loom_aie2p_array_lock_plan_t raised = {
+            .coordinate = coordinate,
+            .lock_id = (uint8_t)lock,
+            .initial_value = tile->lock_value_maximum,
+        };
+        IREE_RETURN_IF_ERROR(loom_aie2p_program_append_lock_initialization(
+            builder, &builder->array, &raised));
+      }
+    }
+  }
+  return iree_ok_status();
+}
