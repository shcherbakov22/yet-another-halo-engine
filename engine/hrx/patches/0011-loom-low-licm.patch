@@ -0,0 +1,80 @@
+// Copyright 2026 The IREE Authors
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+// EXPERIMENTAL: loop-invariant code motion for descriptor-backed low CFGs.
+//
+// The pass body is inert unless the environment variable LOOM_EXP_LICM=1 is
+// set, so the default pipeline output is unchanged.
+//
+// Loops are natural loops of the low.func CFG (a header H plus every block
+// that reaches a back-edge source dominated by H without passing through H).
+// A loop is only transformed when it has a dedicated preheader: exactly one
+// predecessor P of H outside the loop, terminated by an unconditional low.br.
+// No blocks are created.
+//
+// A packet moves to just before P's terminator (relative order preserved)
+// when every operand is defined outside the loop (or by another hoisted
+// packet) and its descriptor proves it pure:
+//   - DEAD_REMOVABLE or SAFE_TO_SPECULATE, and not SIDE_EFFECTING, TERMINATOR,
+//     BARRIER, PSEUDO or UNIQUE_IDENTITY; zero effect rows (effect rows carry
+//     memory, counter, control, barrier and CONVERGENT/cross-lane semantics,
+//     so DPP, permlane, readlane and readfirstlane are excluded); no
+//     OBSERVABLE_EFFECT or memory traits; no regions; at least one result;
+//   - instruction class VECTOR_ALU, or SCALAR_ALU (LOOM_EXP_LICM_SALU), and
+//     none of the memory, matrix, dot, branch, control, barrier, atomic,
+//     cache or LDS-DMA classes;
+//   - no operand row with STATE_WRITE (SCC clobbers, VCC carry-outs, compare
+//     masks, EXEC and MODE writes), TIED or STORAGE_CONTINUATION, and no
+//     PREDICATE/OPERAND_RESULT/unmodeled IMPLICIT rows;
+//   - every STATE_READ row is an implicit SCHEDULE_ONLY_STATE read (the
+//     per-VALU exec read, MODE) of a register class that no op in the loop
+//     writes.
+// EXEC rule: Loom low branches are wave-uniform jumps and exec changes are
+// explicit descriptor packets with STATE_WRITE rows. With no exec write in the
+// loop and a single P->H entry edge, every loop instruction executes under
+// exactly the exec mask live at P's terminator, so hoisted lane-local results
+// are unchanged. SAFE_TO_SPECULATE is only set on a few AMDGPU descriptors, so
+// speculation (hoisting from conditional loop blocks or zero-trip loops)
+// relies on effect-free ALU packets not faulting.
+// Loops containing non-descriptor ops with effects or regions are skipped.
+// Inner (smaller) loops are processed before outer loops.
+//
+// Environment knobs (read once):
+//   LOOM_EXP_LICM=1           schedule the pass (plus a following low-cse
+//                             that merges hoisted duplicates) and enable it.
+//   LOOM_EXP_LICM_MAX=<n>     cap hoisted packets per loop (default unlimited).
+//   LOOM_EXP_LICM_MAX_LIVE=<n> cap VGPR units newly live across each loop. An
+//                             invariant result still used by a packet that
+//                             stays (a "frontier") becomes loop-live; cones of
+//                             frontier producers are chosen greedily by ops
+//                             removed per new live unit (pure-SALU cones are
+//                             free). Default unlimited.
+//   LOOM_EXP_LICM_MIN_GAIN=<n> minimum ops removed per new live unit (2).
+//   LOOM_EXP_LICM_SALU=0      hoist VALU only (SALU hoisting defaults on).
+//   LOOM_EXP_LICM_HEADERS=a,b only transform loops with these header indices.
+//   LOOM_EXP_LICM_DEBUG=1|2   per-loop counts (2: also why each packet stays).
+
+#ifndef LOOM_CODEGEN_LOW_TRANSFORMS_LICM_H_
+#define LOOM_CODEGEN_LOW_TRANSFORMS_LICM_H_
+
+#include "loom/pass/types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Static metadata for the experimental low-licm function pass.
+const loom_pass_info_t* loom_low_licm_pass_info(void);
+
+// Runs low-licm on one low function (no-op unless LOOM_EXP_LICM=1).
+iree_status_t loom_low_licm_run(loom_pass_t* pass, loom_module_t* module,
+                                loom_func_like_t function);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // LOOM_CODEGEN_LOW_TRANSFORMS_LICM_H_
