+// LOOM_EXP_ROUTE_RESET: disables every data master (core, DMA, compass ports)
+// of the tiles in the image's columns before its routes are written. A context
+// that ran an image of another layout keeps that image's masters otherwise: one
+// still selecting a slave this image routes broadcasts its stream into a sink
+// nobody drains, and the stream stalls.
+static iree_status_t loom_aie2p_program_reset_masters(
+    loom_aie2p_array_program_builder_t* builder) {
+  const loom_aie2p_array_plan_t* plan = builder->plan;
+  const loom_xdna_array_family_t* family = plan->family;
+  uint16_t columns = 0;
+  for (iree_host_size_t i = 0; i < plan->route_count; ++i) {
+    columns = iree_max(columns, (uint16_t)(plan->routes[i].coordinate.column + 1));
+  }
+  for (iree_host_size_t i = 0; i < plan->worker_plan_count; ++i) {
+    columns = iree_max(columns,
+                       (uint16_t)(plan->worker_plans[i].coordinate.column + 1));
+  }
+  for (uint16_t column = 0; column < columns; ++column) {
+    for (uint16_t row = 0; row < family->row_count; ++row) {
+      const loom_xdna_tile_coordinate_t coordinate = {.column = column,
+                                                      .row = row};
+      const loom_xdna_tile_facts_t* tile =
+          loom_xdna_array_tile_facts(family, coordinate);
+      if (!tile) continue;
+      uint32_t addresses[256];
+      iree_host_size_t address_count = 0;
+      for (uint8_t r = 0; r < family->stream_port_count; ++r) {
+        const loom_xdna_stream_port_range_t* range = &family->stream_ports[r];
+        if (range->tile_kind != tile->kind ||
+            range->direction != LOOM_XDNA_STREAM_DIRECTION_MASTER) {
+          continue;
+        }
+        switch (range->port) {
+          case LOOM_XDNA_STREAM_PORT_CORE:
+          case LOOM_XDNA_STREAM_PORT_DMA:
+          case LOOM_XDNA_STREAM_PORT_SOUTH:
+          case LOOM_XDNA_STREAM_PORT_WEST:
+          case LOOM_XDNA_STREAM_PORT_NORTH:
+          case LOOM_XDNA_STREAM_PORT_EAST:
+            break;
+          default:
+            continue;
+        }
+        for (uint8_t c = 0; c < range->count; ++c) {
+          const uint16_t indices[] = {(uint16_t)(range->ordinal + c)};
+          loom_aie2p_register_update_t update = {0};
+          IREE_RETURN_IF_ERROR(loom_aie2p_program_resolve_field_update(
+              plan, loom_aie2p_program_stream_master_enable_field(tile->kind),
+              coordinate, IREE_ARRAYSIZE(indices), indices, 0, &update));
+          if (address_count == IREE_ARRAYSIZE(addresses)) abort();
+          addresses[address_count++] = update.address;
+        }
+      }
+      // the shim's packet rules (task-completion routes): every slot of every slave
+      if (tile->kind == LOOM_XDNA_TILE_KIND_SHIM_NOC) {
+        for (uint8_t r = 0; r < family->stream_port_count; ++r) {
+          const loom_xdna_stream_port_range_t* range = &family->stream_ports[r];
+          if (range->tile_kind != tile->kind ||
+              range->direction != LOOM_XDNA_STREAM_DIRECTION_SLAVE) {
+            continue;
+          }
+          for (uint8_t c = 0; c < range->count; ++c) {
+            for (uint16_t slot = 0; slot < 4; ++slot) {
+              const uint16_t indices[] = {(uint16_t)(range->ordinal + c), slot};
+              loom_aie2p_register_update_t update = {0};
+              const iree_status_t status = loom_aie2p_program_resolve_field_update(
+                  plan, LOOM_XDNA_REGISTER_FIELD_SHIM_NOC_STREAM_SLAVE_SLOT_ENABLE,
+                  coordinate, IREE_ARRAYSIZE(indices), indices, 0, &update);
+              if (!iree_status_is_ok(status)) {   // a slave without packet rules
+                iree_status_ignore(status);
+                continue;
+              }
+              if (address_count == IREE_ARRAYSIZE(addresses)) abort();
+              addresses[address_count++] = update.address;
+            }
+          }
+        }
+      }
+      // the tile's master registers, ascending: one zero block per consecutive run
+      for (iree_host_size_t i = 1; i < address_count; ++i) {
+        for (iree_host_size_t j = i; j > 0 && addresses[j - 1] > addresses[j]; --j) {
+          const uint32_t t = addresses[j];
+          addresses[j] = addresses[j - 1], addresses[j - 1] = t;
+        }
+      }
+      for (iree_host_size_t i = 0; i < address_count;) {
+        iree_host_size_t n = 1;
+        while (i + n < address_count && addresses[i + n] == addresses[i] + 4u * n) ++n;
+        memset(loom_aie2p_program_append_register_block_write32(&builder->array, addresses[i], n), 0,
+               n * sizeof(uint32_t));
+        i += n;
+      }
+    }
+  }
+  return iree_ok_status();
+}
